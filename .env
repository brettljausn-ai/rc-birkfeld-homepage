# ── SERVER ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── DATENBANK ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:5432/DATENBANKNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rcbirkfeld

# ── SESSION ───────────────────────────────────────────────
# Mindestens 32 zufällige Zeichen
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── ADMIN ─────────────────────────────────────────────────
# Login-Passwort für /admin
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# ── E-MAIL (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rcbirkfeld@gmail.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
CONTACT_EMAIL=rcbirkfeld@gmail.com

# ── STRAVA API (optional) ─────────────────────────────────
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
