<%- include('partials/head', { title: 'Berichte – RC Birkfeld', description: 'Alle Vereinsberichte und Rückblicke des RC ASVÖ Birkfeld.', ogPath: '/berichte' }) %>
<%- include('partials/nav') %>

<main style="padding:60px 0 100px;">
  <div class="wrap">

    <div style="margin-bottom:48px;">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--rust);text-transform:uppercase;letter-spacing:.1em;font-weight:600;display:block;margin-bottom:10px;">Vereinsleben</span>
      <h1 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(2.2rem,5vw,3.2rem);line-height:1.05;color:var(--ink);margin-bottom:12px;">Alle Berichte</h1>
      <p style="font-size:1rem;color:#777;max-width:500px;"><%= total %> Bericht<%= total !== 1 ? 'e' : '' %> aus dem Vereinsleben</p>
    </div>

    <% if (berichte.length === 0) { %>
    <div style="text-align:center;padding:80px 0;color:#888;">Noch keine Berichte vorhanden.</div>
    <% } else { %>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px;margin-bottom:60px;">
      <% berichte.forEach(function(b) { %>
      <a href="/bericht/<%= b.id %>" style="display:flex;flex-direction:column;text-decoration:none;color:inherit;background:var(--gravel-dark);border:1px solid var(--line);border-radius:10px;overflow:hidden;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <% if (b.image_url) { %>
        <div style="aspect-ratio:16/9;overflow:hidden;background:#f0f0f0;">
          <img src="<%= b.image_url %>" alt="<%= b.title %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.parentNode.style.display='none'">
        </div>
        <% } else { %>
        <div style="aspect-ratio:16/9;background:linear-gradient(135deg,var(--gravel) 0%,var(--gravel-dark) 100%);display:flex;align-items:center;justify-content:center;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" opacity=".2"><path d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2z" stroke="currentColor" stroke-width="1.5"/><path d="M3 9l5-5M9 21l12-12" stroke="currentColor" stroke-width="1.5"/></svg>
        </div>
        <% } %>
        <div style="padding:20px;flex:1;display:flex;flex-direction:column;">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.7rem;color:var(--rust);font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px;">
            <%= new Date(b.published_at).toLocaleDateString('de-AT', {day:'2-digit', month:'long', year:'numeric'}) %>
          </span>
          <h2 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1.25rem;line-height:1.15;color:var(--ink);margin-bottom:10px;flex:1;">
            <%= b.title %>
          </h2>
          <p style="font-size:0.85rem;color:#777;line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
            <%= b.content.replace(/\n/g,' ').substring(0,160) %><%= b.content.length > 160 ? '…' : '' %>
          </p>
          <div style="margin-top:14px;font-size:0.82rem;color:var(--rust);font-weight:700;">Weiterlesen →</div>
        </div>
      </a>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:center;gap:8px;">
      <% if (page > 1) { %>
      <a href="/berichte?page=<%= page - 1 %>" style="display:inline-flex;align-items:center;gap:6px;background:none;border:1.5px solid var(--line);color:var(--ink);padding:8px 18px;border-radius:6px;font-size:0.88rem;font-weight:600;text-decoration:none;">← Newer</a>
      <% } %>
      <span style="font-family:'IBM Plex Mono',monospace;font-size:0.8rem;color:#888;padding:0 8px;">Seite <%= page %> / <%= totalPages %></span>
      <% if (page < totalPages) { %>
      <a href="/berichte?page=<%= page + 1 %>" style="display:inline-flex;align-items:center;gap:6px;background:none;border:1.5px solid var(--line);color:var(--ink);padding:8px 18px;border-radius:6px;font-size:0.88rem;font-weight:600;text-decoration:none;">Older →</a>
      <% } %>
    </div>
    <% } %>

    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
