<%- include('partials/head', { title: bericht.title + ' – RC Birkfeld', description: bericht.content.replace(/<[^>]+>/g,'').substring(0,160).replace(/\n/g,' '), ogType: 'article', ogPath: '/bericht/' + bericht.id, ogImage: bericht.image_url || undefined }) %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "<%- bericht.title.replace(/"/g,'&quot;') %>",
  "datePublished": "<%= new Date(bericht.published_at).toISOString() %>",
  "author": {
    "@type": "Organization",
    "name": "RC ASVÖ Birkfeld"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RC ASVÖ Birkfeld",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.rc-birkfeld.at/images/rcbirkfeld-logo.png"
    }
  },
  "description": "<%= bericht.content.replace(/<[^>]+>/g,'').substring(0,160).replace(/\n/g,' ').replace(/"/g,'&quot;') %>",
  "url": "https://www.rc-birkfeld.at/bericht/<%= bericht.id %>"<% if (bericht.image_url) { %>,
  "image": "<%= bericht.image_url %>"<% } %>
}
</script>
<%- include('partials/nav') %>

<main style="padding:clamp(32px,6vw,60px) 0 clamp(48px,8vw,80px);">
  <div class="wrap" style="max-width:760px;">

    <a href="/berichte" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--rust);text-decoration:none;margin-bottom:32px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Alle Berichte
    </a>

    <% if (bericht.image_url) { %>
    <div style="border-radius:12px;overflow:hidden;margin-bottom:36px;max-height:440px;">
      <img src="<%= bericht.image_url %>" alt="<%= bericht.title %>" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.parentNode.style.display='none'">
    </div>
    <% } %>

    <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--rust);text-transform:uppercase;letter-spacing:.1em;font-weight:600;">
      <%= new Date(bericht.published_at).toLocaleDateString('de-AT',{day:'2-digit',month:'long',year:'numeric'}) %>
    </span>

    <h1 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(2rem,5vw,3rem);line-height:1.05;margin:10px 0 24px;color:var(--ink);">
      <%= bericht.title %>
    </h1>

    <% var _isHtml = bericht.content && /<[a-z][\s\S]*>/i.test(bericht.content); %>
    <div style="font-size:1.05rem;line-height:1.8;color:var(--ink);<% if(!_isHtml){ %>white-space:pre-wrap;<% } %>word-break:break-word;">
      <% if (_isHtml) { %><%- bericht.content %><% } else { %><%= bericht.content %><% } %>
    </div>

    <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--line);">
      <a href="/berichte" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:var(--rust);text-decoration:none;font-weight:600;">
        ← Zurück zu allen Berichten
      </a>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
