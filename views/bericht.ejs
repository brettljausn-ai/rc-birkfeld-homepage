<%- include('partials/head', { title: bericht.title + ' – RC Birkfeld', description: bericht.content.replace(/<[^>]+>/g,'').substring(0,160).replace(/\n/g,' '), ogType: 'article', ogPath: '/bericht/' + bericht.id, ogImage: bericht.image_url || undefined }) %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "<%- bericht.title.replace(/"/g,'&quot;') %>",
  "datePublished": "<%= new Date(bericht.published_at).toISOString() %>",
  "author": {
    "@type": "Organization",
    "name": "RC ASVÖ Birkfeld"
  },
  "publisher": {
    "@type": "Organization",
    "name": "RC ASVÖ Birkfeld",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.rc-birkfeld.at/images/rcbirkfeld-logo.png"
    }
  },
  "description": "<%= bericht.content.replace(/<[^>]+>/g,'').substring(0,160).replace(/\n/g,' ').replace(/"/g,'&quot;') %>",
  "url": "https://www.rc-birkfeld.at/bericht/<%= bericht.id %>"<% if (bericht.image_url) { %>,
  "image": "<%= bericht.image_url %>"<% } %>
}
</script>
<%- include('partials/nav') %>

<main style="padding:clamp(32px,6vw,60px) 0 clamp(48px,8vw,80px);">
  <div class="wrap" style="max-width:760px;">

    <a href="/berichte" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--rust);text-decoration:none;margin-bottom:32px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Alle Berichte
    </a>

    <% if (bericht.image_url) { %>
    <div style="border-radius:12px;overflow:hidden;margin-bottom:36px;max-height:440px;">
      <img src="<%= bericht.image_url %>" alt="<%= bericht.title %>" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.parentNode.style.display='none'">
    </div>
    <% } %>

    <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--rust);text-transform:uppercase;letter-spacing:.1em;font-weight:600;">
      <%= new Date(bericht.published_at).toLocaleDateString('de-AT',{day:'2-digit',month:'long',year:'numeric'}) %>
    </span>

    <h1 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(2rem,5vw,3rem);line-height:1.05;margin:10px 0 24px;color:var(--ink);">
      <%= bericht.title %>
    </h1>

    <% var _isHtml = bericht.content && /<[a-z][\s\S]*>/i.test(bericht.content); %>
    <div class="bericht-body" style="font-size:1.05rem;line-height:1.8;color:var(--ink);<% if(!_isHtml){ %>white-space:pre-wrap;<% } %>word-break:break-word;">
      <% if (_isHtml) { %><%- bericht.content %><% } else { %><%= bericht.content %><% } %>
    </div>

    <% if (photos && photos.length > 0) { %>
    <div class="bericht-fotobox">
      <div class="bericht-fotobox-header">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/><path d="M8 5V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="2"/></svg>
        Fotos vom Event
        <span class="bericht-fotobox-count"><%= photos.length %></span>
      </div>
      <div class="bericht-photo-grid" id="berichtPhotoGrid">
        <% photos.forEach(function(p, idx) { %>
        <div class="bericht-photo-item" onclick="bpLbOpen(<%= idx %>)" title="<%= p.caption || '' %>">
          <img src="<%= p.data_url %>" alt="<%= p.caption || 'Foto ' + (idx+1) %>" loading="lazy">
          <% if (p.caption) { %><div class="bericht-photo-cap"><%= p.caption %></div><% } %>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <div style="margin-top:48px;padding-top:24px;border-top:1px solid var(--line);">
      <a href="/berichte" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:var(--rust);text-decoration:none;font-weight:600;">
        ← Zurück zu allen Berichten
      </a>
    </div>

  </div>
</main>

<% if (photos && photos.length > 0) { %>
<div class="lb" id="bpLb" role="dialog" aria-modal="true">
  <button class="lb-close" id="bpClose" aria-label="Schließen">×</button>
  <button class="lb-prev" id="bpPrev" aria-label="Zurück">‹</button>
  <img class="lb-img" id="bpImg" src="" alt="">
  <button class="lb-next" id="bpNext" aria-label="Weiter">›</button>
  <div class="lb-meta">
    <div class="lb-cap" id="bpCap"></div>
    <div class="lb-count" id="bpCount"></div>
  </div>
</div>
<script>
(function(){
  var photos = <%- JSON.stringify(photos.map(function(p){ return { src: p.data_url, cap: p.caption||'' }; })) %>;
  var cur = 0;
  var lb = document.getElementById('bpLb');
  var img = document.getElementById('bpImg');
  var cap = document.getElementById('bpCap');
  var cnt = document.getElementById('bpCount');
  function show(i){
    cur = (i + photos.length) % photos.length;
    img.style.opacity='0.4';
    img.src = photos[cur].src;
    img.onload = function(){ img.style.opacity='1'; };
    cap.textContent = photos[cur].cap;
    cnt.textContent = (cur+1) + ' / ' + photos.length;
  }
  window.bpLbOpen = function(i){ lb.classList.add('open'); show(i); document.body.style.overflow='hidden'; };
  document.getElementById('bpClose').onclick = function(){ lb.classList.remove('open'); document.body.style.overflow=''; };
  document.getElementById('bpPrev').onclick = function(){ show(cur-1); };
  document.getElementById('bpNext').onclick = function(){ show(cur+1); };
  lb.addEventListener('click', function(e){ if(e.target===lb){ lb.classList.remove('open'); document.body.style.overflow=''; } });
  document.addEventListener('keydown', function(e){
    if(!lb.classList.contains('open')) return;
    if(e.key==='Escape'){ lb.classList.remove('open'); document.body.style.overflow=''; }
    if(e.key==='ArrowLeft') show(cur-1);
    if(e.key==='ArrowRight') show(cur+1);
  });
  var ts=0;
  lb.addEventListener('touchstart',function(e){ ts=e.touches[0].clientX; },{passive:true});
  lb.addEventListener('touchend',function(e){ var dx=e.changedTouches[0].clientX-ts; if(Math.abs(dx)>50){ show(dx<0?cur+1:cur-1); } },{passive:true});
})();
</script>
<% } %>

<%- include('partials/footer') %>
