<%
  var isPast = new Date(termin.date) < new Date();
  var pageTitle = isPast ? ('Rückblick: ' + termin.title) : termin.title;
%>
<%- include('partials/head', { title: pageTitle + ' – RC Birkfeld', description: termin.description || (termin.title + ' am ' + new Date(termin.date).toLocaleDateString('de-AT', {day:'2-digit',month:'long',year:'numeric'})), ogType: 'event', ogPath: '/termin/' + termin.id }) %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "<%- termin.title.replace(/"/g,'&quot;') %>",
  "startDate": "<%= new Date(termin.date).toISOString().split('T')[0] %>",
  "eventStatus": "https://schema.org/Event<%= new Date(termin.date) < new Date() ? 'Completed' : 'Scheduled' %>",
  "location": {
    "@type": "Place",
    "name": "<%= (termin.location || 'Birkfeld, Steiermark').replace(/"/g,'') %>",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Birkfeld",
      "addressRegion": "Steiermark",
      "addressCountry": "AT"
    }
  },
  "organizer": {
    "@type": "SportsClub",
    "name": "RC ASVÖ Birkfeld",
    "url": "https://www.rc-birkfeld.at"
  },
  "url": "https://www.rc-birkfeld.at/termin/<%= termin.id %>",
  "sport": "Cycling"
}
</script>
<%- include('partials/nav') %>

<main style="padding:clamp(32px,6vw,60px) 0 clamp(48px,8vw,100px);">
  <div class="wrap" style="max-width:760px;">

    <a href="<%= isPast ? '/#berichte' : '/#termine' %>" style="display:inline-flex;align-items:center;gap:6px;font-size:0.82rem;color:var(--rust);text-decoration:none;margin-bottom:40px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= isPast ? 'Alle Berichte' : 'Alle Termine' %>
    </a>

    <% if (isPast) { %>
    <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--rust);text-transform:uppercase;letter-spacing:.1em;font-weight:600;display:inline-block;margin-bottom:14px;">Rückblick</span>
    <% } %>

    <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#888;text-transform:uppercase;letter-spacing:.1em;font-weight:600;display:flex;align-items:center;gap:10px;margin-bottom:14px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <%= new Date(termin.date).toLocaleDateString('de-AT', {weekday:'long', day:'2-digit', month:'long', year:'numeric'}) %>
    </span>

    <h1 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(2rem,5vw,3rem);line-height:1.05;margin-bottom:32px;color:var(--ink);">
      <%= termin.title %>
    </h1>

    <!-- Meta-Infos -->
    <div style="display:flex;flex-wrap:wrap;gap:12px;margin-bottom:40px;">
      <% if (termin.tag) { %>
      <span style="background:var(--rust);color:#fff;font-size:0.75rem;font-weight:700;padding:4px 12px;border-radius:2px;letter-spacing:.05em;text-transform:uppercase;"><%= termin.tag %></span>
      <% } %>
      <% if (termin.location) { %>
      <span style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:#555;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2"/></svg>
        <%= termin.location %>
      </span>
      <% } %>
      <% if (isPast && yesNames.length) { %>
      <span style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:#555;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="2"/></svg>
        <%= yesNames.length %> Teilnehmer
      </span>
      <% } %>
    </div>

    <% if (termin.description) { %>
    <div style="font-size:1.05rem;line-height:1.8;color:var(--ink);white-space:pre-wrap;word-break:break-word;margin-bottom:40px;">
      <%= termin.description %>
    </div>
    <% } %>

    <% if (isPast) { %>
    <!-- ── Rückblick: Teilnehmer ── -->
    <% if (yesNames.length || noNames.length) { %>
    <div style="background:var(--gravel-dark);border:1px solid var(--line);border-radius:10px;padding:24px;margin-bottom:40px;">
      <p style="font-size:0.78rem;text-transform:uppercase;letter-spacing:.1em;color:#888;font-weight:700;margin-bottom:16px;">Teilnahme</p>
      <div style="display:flex;gap:32px;flex-wrap:wrap;">
        <% if (yesNames.length) { %>
        <div>
          <p style="font-size:0.72rem;color:#1F7A34;font-weight:700;margin-bottom:8px;">DABEI · <%= yesNames.length %></p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <% yesNames.forEach(function(n){ %>
            <span style="background:#e8f5e9;color:#1F7A34;font-size:0.8rem;font-weight:600;padding:3px 10px;border-radius:20px;"><%= n %></span>
            <% }); %>
          </div>
        </div>
        <% } %>
        <% if (noNames.length) { %>
        <div>
          <p style="font-size:0.72rem;color:#c62828;font-weight:700;margin-bottom:8px;">NICHT DABEI · <%= noNames.length %></p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <% noNames.forEach(function(n){ %>
            <span style="background:#ffebee;color:#c62828;font-size:0.8rem;font-weight:600;padding:3px 10px;border-radius:20px;"><%= n %></span>
            <% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (linkedBericht) { %>
    <div style="background:var(--gravel-dark);border:1px solid var(--line);border-radius:10px;padding:20px;margin-bottom:40px;display:flex;align-items:center;justify-content:space-between;gap:16px;">
      <div>
        <p style="font-size:0.72rem;text-transform:uppercase;letter-spacing:.1em;color:#888;font-weight:700;margin-bottom:4px;">Vereinsbericht</p>
        <p style="font-size:0.9rem;font-weight:600;color:var(--ink);"><%= linkedBericht.title %></p>
      </div>
      <a href="/bericht/<%= linkedBericht.id %>" style="background:var(--rust);color:#fff;padding:8px 18px;border-radius:4px;font-size:0.85rem;font-weight:700;text-decoration:none;white-space:nowrap;">Bericht lesen →</a>
    </div>
    <% } %>

    <% } else { %>
    <!-- ── Upcoming: RSVP ── -->
    <% if (memberName) { %>
    <div style="background:var(--gravel-dark);border:1px solid var(--line);border-radius:10px;padding:24px;margin-bottom:40px;">
      <p style="font-size:0.78rem;text-transform:uppercase;letter-spacing:.1em;color:#888;font-weight:700;margin-bottom:16px;">Ich bin dabei?</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <form method="POST" action="/club/rsvp/<%= termin.id %>?redirect=/termin/<%= termin.id %>">
          <input type="hidden" name="status" value="yes">
          <button type="submit" style="background:<%= myRsvp==='yes'?'#1F7A34':'none' %>;border:2px solid <%= myRsvp==='yes'?'#1F7A34':'#ddd' %>;color:<%= myRsvp==='yes'?'#fff':'#555' %>;padding:9px 22px;border-radius:6px;font-size:0.88rem;font-weight:700;cursor:pointer;font-family:inherit;">
            ✓ Ja, ich bin dabei
          </button>
        </form>
        <form method="POST" action="/club/rsvp/<%= termin.id %>?redirect=/termin/<%= termin.id %>">
          <input type="hidden" name="status" value="no">
          <button type="submit" style="background:<%= myRsvp==='no'?'#c62828':'none' %>;border:2px solid <%= myRsvp==='no'?'#c62828':'#ddd' %>;color:<%= myRsvp==='no'?'#fff':'#555' %>;padding:9px 22px;border-radius:6px;font-size:0.88rem;font-weight:700;cursor:pointer;font-family:inherit;">
            ✗ Ich kann nicht
          </button>
        </form>
      </div>
      <% if (yesNames.length || noNames.length) { %>
      <div style="margin-top:18px;display:flex;gap:24px;flex-wrap:wrap;">
        <% if (yesNames.length) { %>
        <div>
          <p style="font-size:0.72rem;color:#1F7A34;font-weight:700;margin-bottom:6px;">DABEI (<%= yesNames.length %>)</p>
          <p style="font-size:0.85rem;color:var(--ink);"><%= yesNames.join(', ') %></p>
        </div>
        <% } %>
        <% if (noNames.length) { %>
        <div>
          <p style="font-size:0.72rem;color:#c62828;font-weight:700;margin-bottom:6px;">NICHT DABEI (<%= noNames.length %>)</p>
          <p style="font-size:0.85rem;color:var(--ink);"><%= noNames.join(', ') %></p>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
    <% } else { %>
    <div style="background:var(--gravel-dark);border:1px solid var(--line);border-radius:10px;padding:20px;margin-bottom:40px;font-size:0.9rem;color:#666;">
      <a href="/club/login" style="color:var(--rust);font-weight:700;">Im Mitgliederbereich anmelden</a> um zu- oder absagen zu können.
    </div>
    <% } %>
    <% } %>

    <div style="padding-top:24px;border-top:1px solid var(--line);">
      <a href="<%= isPast ? '/#berichte' : '/#termine' %>" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;color:var(--rust);text-decoration:none;font-weight:600;">
        ← <%= isPast ? 'Alle Berichte' : 'Alle Termine' %>
      </a>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
