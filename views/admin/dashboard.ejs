<!-- ══ SPONSOREN ══ -->
<div id="panel-sponsors" class="panel <%= activeTab==='sponsors'?'active':'' %>">
  <div class="card">
    <h2>Sponsor hinzufügen</h2>
    <form method="POST" action="/admin/sponsors" enctype="multipart/form-data">
      <div class="form-row">
        <div class="field"><label>Name</label><input name="name" required></div>
        <div class="field"><label>Website (optional)</label><input type="url" name="website_url" placeholder="https://..."></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Logo (PNG/SVG/WebP)</label><input type="file" name="logo" accept="image/*" required></div>
        <div class="field" style="max-width:160px;"><label>Reihenfolge</label><input type="number" name="sort_order" value="0"></div>
      </div>
      <button class="btn-save" type="submit">Speichern</button>
    </form>
  </div>

  <div class="section-divider">Sponsoren (<%= sponsors.length %>)</div>
  <div class="sponsor-admin-grid">
    <% sponsors.forEach(s => { %>
    <div class="sponsor-card">
      <div class="sponsor-preview"><img src="<%= s.logo %>" alt="<%= s.name %>"></div>
      <div class="sponsor-card-body">
        <form method="POST" action="/admin/sponsors/<%= s.id %>/edit" style="margin-bottom:10px;">
          <div class="field"><label>Name</label><input name="name" value="<%= s.name %>" required></div>
          <div class="field"><label>Website</label><input type="url" name="website_url" value="<%= s.website_url||'' %>" placeholder="https://..."></div>
          <button class="btn-save" type="submit" style="padding:5px 10px;font-size:0.78rem;">Speichern</button>
        </form>
        <form method="POST" action="/admin/sponsors/<%= s.id %>/delete" onsubmit="return confirm('Sponsor löschen?')">
          <button class="btn-del" style="width:100%;">Löschen</button>
        </form>
      </div>
    </div>
    <% }); %>
    <% if(sponsors.length===0){%><p style="color:#999;font-size:0.9rem;grid-column:1/-1;">Noch keine Sponsoren.</p><%}%>
  </div>
</div>

<script>
function showTab(id, btn) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('panel-' + id).classList.add('active');
  btn.classList.add('active');
}

function toggleEdit(id) {
  const el = document.getElementById(id);
  el.classList.toggle('open');
}

/* Strava Test */
document.getElementById('testStravaBtn').addEventListener('click', async () => {
  const btn = document.getElementById('testStravaBtn');
  const result = document.getElementById('testStravaResult');
  btn.textContent = '…';
  const res = await fetch('/admin/test-strava', { method: 'POST' });
  const data = await res.json();
  result.textContent = data.msg;
  result.style.color = data.ok ? '#4CAF50' : '#e53935';
  result.style.display = 'inline';
  btn.textContent = 'Strava testen';
});

/* E-Mail Test */
document.getElementById('testEmailBtn').addEventListener('click', async () => {
  const btn = document.getElementById('testEmailBtn');
  const result = document.getElementById('testEmailResult');
  btn.textContent = '…';
  const res = await fetch('/admin/test-email', { method: 'POST' });
  const data = await res.json();
  result.textContent = data.msg;
  result.style.color = data.ok ? '#4CAF50' : '#e53935';
  result.style.display = 'inline';
  btn.textContent = 'E-Mail testen';
});

/* News image drop zones */
function initNewsDropZone(zone) {
  var targetId = zone.dataset.target;
  var hiddenField = document.getElementById(targetId);
  var fileInput = zone.querySelector('input[type=file]');
  var preview = zone.querySelector('.news-drop-preview');
  var previewImg = preview.querySelector('img');
  var removeBtn = preview.querySelector('.news-drop-remove');
  var status = zone.querySelector('.news-upload-status');

  zone.addEventListener('click', function(e) {
    if (e.target === removeBtn) return;
    fileInput.click();
  });
  zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.classList.add('over'); });
  zone.addEventListener('dragleave', function() { zone.classList.remove('over'); });
  zone.addEventListener('drop', function(e) {
    e.preventDefault(); zone.classList.remove('over');
    if (e.dataTransfer.files[0]) uploadNewsImage(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', function() {
    if (fileInput.files[0]) uploadNewsImage(fileInput.files[0]);
  });
  removeBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    hiddenField.value = '';
    previewImg.src = '';
    preview.style.display = 'none';
    status.textContent = '';
    fileInput.value = '';
  });

  function uploadNewsImage(file) {
    if (!file.type.match(/^image\//)) { status.textContent = 'Nur Bilder erlaubt.'; return; }
    previewImg.src = URL.createObjectURL(file);
    preview.style.display = 'block';
    status.textContent = 'Wird hochgeladen…';
    var fd = new FormData();
    fd.append('image', file);
    fetch('/admin/upload-news-image', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.url) { hiddenField.value = data.url; status.textContent = 'Bild bereit.'; }
        else { status.textContent = 'Fehler.'; preview.style.display = 'none'; }
      })
      .catch(function() { status.textContent = 'Fehler.'; });
  }
}
document.querySelectorAll('.news-drop').forEach(initNewsDropZone);

/* Drag & Drop Galerie Reihenfolge */
(function() {
  const grid = document.getElementById('sortable-gallery');
  if (!grid) return;
  let dragged = null;
  grid.addEventListener('dragstart', e => {
    dragged = e.target.closest('.gallery-tile');
    if (dragged) { dragged.style.opacity = '0.4'; dragged.style.borderColor = '#4CAF50'; }
  });
  grid.addEventListener('dragend', () => {
    if (dragged) { dragged.style.opacity = ''; dragged.style.borderColor = ''; dragged = null; }
  });
  grid.addEventListener('dragover', e => {
    e.preventDefault();
    const target = e.target.closest('.gallery-tile');
    if (target && target !== dragged) {
      const tiles = [...grid.querySelectorAll('.gallery-tile')];
      grid.insertBefore(dragged, tiles.indexOf(target) > tiles.indexOf(dragged) ? target.nextSibling : target);
    }
  });
  document.getElementById('btn-save-order').addEventListener('click', async () => {
    const order = [...grid.querySelectorAll('.gallery-tile')].map(t => parseInt(t.dataset.id));
    const res = await fetch('/admin/gallery/reorder', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({order}) });
    if (res.ok) {
      const s = document.getElementById('order-status');
      s.style.display = 'inline';
      setTimeout(() => s.style.display = 'none', 2500);
    }
  });
})();
</script>
</body>
</html>
