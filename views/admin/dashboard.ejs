        <div class="field"><label>Datum</label><input type="date" name="date" required></div>
      </div>
      <div class="form-row">
        <div class="field"><label>Ort</label><input name="location"></div>
        <div class="field"><label>Tag</label><input name="tag" value="Vereinsrennen"></div>
