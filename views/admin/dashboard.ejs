<!-- ══ BERICHTE ══ -->
<div id="panel-news" class="panel <%= activeTab==='news'?'active':'' %>">
  <div class="card">
    <h2>Neuer Bericht</h2>
    <form method="POST" action="/admin/news">
      <div class="form-row">
        <div class="field"><label>Titel</label><input name="title" required></div>
        <div class="field"><label>Datum</label><input type="date" name="published_at" value="<%= new Date().toISOString().split('T')[0] %>"></div>
      </div>
      <div class="field">
        <label>Inhalt</label>
        <div class="ql-news-editor">
          <div class="ql-editor-div"></div>
          <textarea name="content" class="ql-hidden-input" style="display:none"></textarea>
        </div>
      </div>
      <div class="field">
        <label>Bild (optional)</label>
        <div class="news-drop" id="drop-new" data-target="image_url_new">
          <input type="file" accept="image/*">
          ↑ Bild hier ablegen oder klicken
          <div class="news-drop-preview"><img src="" alt=""><button class="news-drop-remove" type="button">×</button></div>
          <div class="news-upload-status"></div>
        </div>
        <input type="hidden" name="image_url" id="image_url_new">
      </div>
      <button class="btn-save" type="submit">Speichern</button>
    </form>
  </div>

  <div class="section-divider">Bestehende Berichte</div>
  <table>
    <thead><tr><th>Datum</th><th>Titel</th><th>Inhalt</th><th></th></tr></thead>
    <tbody>
    <% news.forEach(n => { %>
    <tr>
      <td style="white-space:nowrap;"><%= new Date(n.published_at).toLocaleDateString('de-AT') %></td>
      <td><strong><%= n.title %></strong></td>
      <td style="color:#666;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= n.content.replace(/<[^>]+>/g,'').substring(0,80) %></td>
      <td><div class="actions">
        <button class="btn-edit" onclick="toggleEdit('news-<%= n.id %>')">Bearbeiten</button>
        <form method="POST" action="/admin/news/<%= n.id %>/delete" onsubmit="return confirm('Löschen?')"><button class="btn-del">Löschen</button></form>
      </div></td>
    </tr>
    <tr><td colspan="4" style="padding:0;">
      <div class="edit-form" id="news-<%= n.id %>">
        <form method="POST" action="/admin/news/<%= n.id %>/edit">
          <div class="form-row">
            <div class="field"><label>Titel</label><input name="title" value="<%= n.title %>" required></div>
            <div class="field"><label>Datum</label><input type="date" name="published_at" value="<%= new Date(n.published_at).toISOString().split('T')[0] %>"></div>
          </div>
          <div class="field">
            <label>Inhalt</label>
            <div class="ql-news-editor">
              <div class="ql-editor-div"></div>
              <textarea name="content" class="ql-hidden-input" style="display:none"><%= n.content %></textarea>
            </div>
          </div>
          <div class="field">
            <label>Bild</label>
            <div class="news-drop" id="drop-<%= n.id %>" data-target="image_url_<%= n.id %>">
              <input type="file" accept="image/*">
              ↑ Bild hier ablegen oder klicken
              <div class="news-drop-preview" <% if(n.image_url){%>style="display:block;"<%}%>>
                <img src="<%= n.image_url||'' %>" alt="">
                <button class="news-drop-remove" type="button">×</button>
              </div>
              <div class="news-upload-status"></div>
            </div>
            <input type="hidden" name="image_url" id="image_url_<%= n.id %>" value="<%= n.image_url||'' %>">
          </div>
          <div class="actions"><button class="btn-save" type="submit">Speichern</button><button class="btn-cancel" type="button" onclick="toggleEdit('news-<%= n.id %>')">Abbrechen</button></div>
        </form>
      </div>
    </td></tr>
    <% }); %>
    <% if(news.length===0){%><tr><td colspan="4" style="color:#999;text-align:center;padding:20px;">Noch keine Berichte.</td></tr><%}%>
    </tbody>
  </table>
</div>

<!-- ══ TERMINE ══ -->
<div id="panel-termine" class="panel <%= activeTab==='termine'?'active':'' %>">
