<div id="panel-polls" class="panel <%= activeTab==='polls'?'active':'' %>">
  <div class="card">
    <h2>Neue Abstimmung erstellen</h2>
    <form method="POST" action="/admin/polls">
      <div class="field"><label>Frage</label><input type="text" name="question" placeholder="Wohin soll die nächste Samstagsausfahrt gehen?" required maxlength="300"></div>
      <div class="field">
        <label>Optionen <span style="font-weight:400;color:#bbb;">(eine pro Zeile, mind. 2)</span></label>
        <textarea name="options" rows="5" placeholder="Laurentiberg&#10;Rabenwald&#10;Richtung Wechsel&#10;Gemeindeausfahrt Joglland" required></textarea>
      </div>
      <div class="field" style="max-width:220px;"><label>Läuft ab (optional)</label><input type="datetime-local" name="expires_at"></div>
      <button class="btn-save" type="submit">Abstimmung starten</button>
    </form>
  </div>

  <div class="section-divider">Abstimmungen (<%= polls.length %>)</div>
  <% if (!polls.length) { %><p style="color:#999;font-size:0.9rem;">Noch keine Abstimmungen.</p>
  <% } else { %>
  <table>
    <thead><tr><th>Status</th><th>Frage</th><th>Erstellt</th><th>Aktionen</th></tr></thead>
    <tbody>
    <% polls.forEach(function(p) { %>
    <tr>
