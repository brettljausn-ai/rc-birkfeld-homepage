      <td><strong><%= m.name %></strong></td>
      <td><a href="mailto:<%= m.email %>"><%= m.email %></a></td>
      <td>
        <form method="POST" action="/admin/club-members/email/<%= m.id %>/delete" onsubmit="return confirm('Mitglied löschen?')">
          <button class="btn-del">Löschen</button>
