/* News image drop zones */
function initNewsDropZone(zone) {
  var targetId = zone.dataset.target;
  var hiddenField = document.getElementById(targetId);
  var fileInput = zone.querySelector('input[type=file]');
  var preview = zone.querySelector('.news-drop-preview');
  var previewImg = preview.querySelector('img');
  var removeBtn = preview.querySelector('.news-drop-remove');
  var status = zone.querySelector('.news-upload-status');

  zone.addEventListener('click', function(e) {
    if (e.target === removeBtn) return;
    fileInput.click();
  });
  zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.classList.add('over'); });
  zone.addEventListener('dragleave', function() { zone.classList.remove('over'); });
  zone.addEventListener('drop', function(e) {
    e.preventDefault(); zone.classList.remove('over');
    if (e.dataTransfer.files[0]) uploadNewsImage(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', function() {
    if (fileInput.files[0]) uploadNewsImage(fileInput.files[0]);
  });
  removeBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    hiddenField.value = '';
    previewImg.src = '';
    preview.style.display = 'none';
    status.textContent = '';
    fileInput.value = '';
  });

  function uploadNewsImage(file) {
    if (!file.type.match(/^image\//)) { status.textContent = 'Nur Bilder erlaubt.'; return; }
    previewImg.src = URL.createObjectURL(file);
    preview.style.display = 'block';
    status.textContent = 'Wird hochgeladen…';
    var fd = new FormData();
    fd.append('image', file);
    fetch('/admin/upload-news-image', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.url) { hiddenField.value = data.url; status.textContent = 'Bild bereit.'; }
        else { status.textContent = 'Fehler.'; preview.style.display = 'none'; }
      })
      .catch(function() { status.textContent = 'Fehler.'; });
  }
}
document.querySelectorAll('.news-drop').forEach(initNewsDropZone);

/* Galerie Upload Drop Zone */
(function(){
  const zone = document.getElementById('galleryDropZone');
  const input = document.getElementById('galleryFileInput');
  const label = document.getElementById('galleryDropLabel');
  const previewGrid = document.getElementById('galleryPreviewGrid');
  const btn = document.getElementById('galleryUploadBtn');
  const countSpan = document.getElementById('galleryUploadCount');
  if(!zone) return;

  zone.addEventListener('click', () => input.click());
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor='#1F7A34'; zone.style.background='#f0faf2'; });
  zone.addEventListener('dragleave', () => { zone.style.borderColor='#ddd'; zone.style.background='#fafafa'; });
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.style.borderColor='#ddd'; zone.style.background='#fafafa';
    const dt = new DataTransfer();
    Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/')).forEach(f => dt.items.add(f));
    input.files = dt.files;
    showPreviews(input.files);
  });
  input.addEventListener('change', () => showPreviews(input.files));

  function showPreviews(files) {
    if(!files || !files.length) { label.style.display=''; previewGrid.style.display='none'; btn.disabled=true; btn.style.opacity='.5'; countSpan.textContent=''; return; }
    label.style.display = 'none';
    previewGrid.style.display = 'flex';
    previewGrid.innerHTML = '';
    Array.from(files).forEach(f => {
      const reader = new FileReader();
      reader.onload = ev => {
        const img = document.createElement('img');
        img.src = ev.target.result;
        img.style.cssText = 'width:80px;height:60px;object-fit:cover;border-radius:4px;border:1px solid #ddd;';
        previewGrid.appendChild(img);
      };
      reader.readAsDataURL(f);
    });
    btn.disabled = false; btn.style.opacity = '1';
    countSpan.textContent = files.length + ' Foto' + (files.length>1?'s':'') + ' ausgewählt';
  }
})();

/* Drag & Drop Galerie Reihenfolge */
(function() {
  const grid = document.getElementById('sortable-gallery');
  if (!grid) return;
  let dragged = null;
  grid.addEventListener('dragstart', e => {
    dragged = e.target.closest('.gallery-tile');
    if (dragged) { dragged.style.opacity = '0.4'; dragged.style.borderColor = '#4CAF50'; }
  });
  grid.addEventListener('dragend', () => {
    if (dragged) { dragged.style.opacity = ''; dragged.style.borderColor = ''; dragged = null; }
  });
  grid.addEventListener('dragover', e => {
    e.preventDefault();
    const target = e.target.closest('.gallery-tile');
    if (target && target !== dragged) {
      const tiles = [...grid.querySelectorAll('.gallery-tile')];
      grid.insertBefore(dragged, tiles.indexOf(target) > tiles.indexOf(dragged) ? target.nextSibling : target);
    }
  });
  document.getElementById('btn-save-order').addEventListener('click', async () => {
    const order = [...grid.querySelectorAll('.gallery-tile')].map(t => parseInt(t.dataset.id));
    const res = await fetch('/admin/gallery/reorder', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({order}) });
    if (res.ok) {
      const s = document.getElementById('order-status');
      s.style.display = 'inline';
      setTimeout(() => s.style.display = 'none', 2500);
    }
  });
})();
</script>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
/* ── navToTab helper ── */
function navToTab(name) {
  var btns = document.querySelectorAll('.tab');
  for (var i = 0; i < btns.length; i++) {
    var oc = btns[i].getAttribute('onclick') || '';
    if (oc.indexOf("'" + name + "'") > -1) { btns[i].click(); return; }
  }
}

/* ── Quill init ── */
(function() {
  var toolbarOpts = [
    ['bold', 'italic', 'underline'],
    [{ list: 'ordered' }, { list: 'bullet' }],
    ['link', 'clean']
  ];

  document.querySelectorAll('.ql-news-editor').forEach(function(wrapper) {
    var textarea = wrapper.querySelector('.ql-hidden-input');
    var editorDiv = wrapper.querySelector('.ql-editor-div');

    var quill = new Quill(editorDiv, {
      theme: 'snow',
      modules: { toolbar: toolbarOpts },
      placeholder: 'Bericht-Text eingeben…'
    });

    var content = textarea.value.trim();
    if (content) {
      if (/<[a-z][\s\S]*>/i.test(content)) {
        quill.clipboard.dangerouslyPasteHTML(content);
      } else {
        quill.setText(content);
      }
    }

    textarea.closest('form').addEventListener('submit', function(e) {
      var text = quill.getText().trim();
      if (!text) {
        e.preventDefault();
        wrapper.classList.add('ql-error');
        editorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      wrapper.classList.remove('ql-error');
      textarea.value = quill.root.innerHTML;
    });

    quill.on('text-change', function() {
      wrapper.classList.remove('ql-error');
    });
  });
})();
</script>

