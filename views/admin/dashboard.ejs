            <div class="field"><label>Titel</label><input name="title" value="Rückblick: <%= t.title %>" required></div>
            <div class="field"><label>Datum</label><input type="date" name="published_at" value="<%= new Date(t.date).toISOString().split('T')[0] %>"></div>
