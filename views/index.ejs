          '<a href="'+escH(ev.detail_url)+'" target="_blank" rel="noopener" class="strava-event-link">Details →</a>'+
          '</div>';
      }).join('')+'</div>';
  }
  card.innerHTML =
    '<div class="strava-card-main"><span class="strava-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M13.5 2L6 15h4.5L9 22l7.5-13H12l1.5-7z" fill="var(--chalk)"/></svg></span><div><h3>'+escH(s.name||'RC ASVÖ Birkfeld')+'</h3><span class="strava-sub">Radsport-Club auf Strava</span></div></div>'+
    '<div class="strava-stats"><div class="strava-stat"><span class="num">'+escH(s.member_count||0)+'</span><span class="lbl">Mitglieder auf Strava</span></div><div class="strava-stat"><span class="num">'+(s.activity_types?s.activity_types.length:8)+'</span><span class="lbl">Disziplinen im Club</span></div></div>'+
    evHtml+
    '<div class="strava-tags"><span>Rennrad</span><span>Gravel</span><span>Mountainbike</span><span>E-Bike</span><span>E-MTB</span><span>Handbike</span><span>Velomobil</span><span>Rolle / Virtual</span></div>'+
    '<a href="https://www.strava.com/clubs/300701" target="_blank" rel="noopener" class="btn btn-outline-dark">Club auf Strava ansehen →</a>';
}).catch(function(){document.getElementById('stravaCard').closest('section').style.display='none';});

// ── Strava Jahresrückblick ──
fetch('/api/strava-stats').then(function(r){return r.json();}).then(function(s){
  if(!s) return;
  var year = new Date().getFullYear();
  var ytd = s.ytd_ride_totals;
  var rec = s.recent_ride_totals;
  if(!ytd || !ytd.count) return;
  function fmtKm(m){return (m/1000).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g,'.');}
  function fmtHm(m){return Math.round(m).toLocaleString('de-AT');}
  function fmtTime(s){var h=Math.floor(s/3600);return h.toLocaleString('de-AT');}
  document.getElementById('jrLabel').textContent = 'Jahresrückblick '+year+' · YTD';
  var stats = [
    {num: fmtKm(ytd.distance)+' km', lbl: 'Gefahrene Kilometer'},
    {num: fmtHm(ytd.elevation_gain)+' hm', lbl: 'Höhenmeter'},
    {num: ytd.count, lbl: 'Aktivitäten'},
    {num: fmtTime(ytd.moving_time)+' h', lbl: 'Bewegungszeit'},
  ];
  document.getElementById('jrStats').innerHTML = stats.map(function(st){
    return '<div><div style="font-family:\'Big Shoulders Display\',sans-serif;font-weight:900;font-size:2rem;color:#4CAF50;line-height:1;margin-bottom:4px;">'+escH(String(st.num))+'</div>'
      +'<div style="font-size:0.78rem;color:#666;font-family:\'IBM Plex Mono\',monospace;">'+escH(st.lbl)+'</div></div>';
  }).join('');
  // progress bar: recent km vs ytd km as % of rough annual target
  if(rec && rec.distance && ytd.distance){
    var pct = Math.min(100, Math.round((rec.distance/ytd.distance)*100));
    document.getElementById('jrBarWrap').style.display='block';
    setTimeout(function(){document.getElementById('jrBar').style.width=pct+'%';},100);
    document.getElementById('jrBarLabel').textContent = 'Letzte 4 Wochen: '+fmtKm(rec.distance)+' km · '+rec.count+' Aktivitäten';
  }
  document.getElementById('jahresrueckblick').style.display='block';
}).catch(function(){});

// ── Wetter-Widget (Open-Meteo, kein API-Key nötig) ──
(function(){
  var DAYS = ['So','Mo','Di','Mi','Do','Fr','Sa'];
  var MONTHS = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  function wmoIcon(code){
    if(code===0) return '☀️';
    if(code<=2) return '⛅';
    if(code===3) return '☁️';
    if(code<=48) return '🌫';
    if(code<=55) return '🌦';
    if(code<=65) return '🌧';
    if(code<=75) return '🌨';
    if(code<=82) return '🌦';
    return '⛈';
  }
  function wmoText(code){
    if(code===0) return 'Sonnig';
    if(code<=2) return 'Leicht bewölkt';
    if(code===3) return 'Bedeckt';
    if(code<=48) return 'Nebelig';
    if(code<=55) return 'Nieselregen';
    if(code<=65) return 'Regen';
    if(code<=75) return 'Schneefall';
    if(code<=82) return 'Schauer';
    return 'Gewitter';
  }
  fetch('https://api.open-meteo.com/v1/forecast?latitude=47.37&longitude=15.50&current=temperature_2m,weathercode,windspeed_10m,relative_humidity_2m&daily=weathercode,temperature_2m_max,temperature_2m_min&timezone=Europe%2FVienna&forecast_days=4')
    .then(function(r){return r.json();})
    .then(function(d){
      var cur = d.current;
      var daily = d.daily;
      document.getElementById('wCurIcon').textContent = wmoIcon(cur.weathercode);
      document.getElementById('wCurTemp').textContent = Math.round(cur.temperature_2m)+'°';
      document.getElementById('wCurDesc').textContent = wmoText(cur.weathercode);
      document.getElementById('wCurMeta').textContent = '💨 '+Math.round(cur.windspeed_10m)+' km/h · 💧 '+cur.relative_humidity_2m+'%';
      // forecast: skip today (index 0), show next 3 days
      var fHtml = '';
      for(var i=1;i<4;i++){
        var dt = new Date(daily.time[i]);
        fHtml += '<div style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:8px;padding:8px 12px;text-align:center;min-width:62px;">'
          +'<div style="font-family:\'IBM Plex Mono\',monospace;font-size:0.62rem;color:#555;text-transform:uppercase;margin-bottom:3px;">'+DAYS[dt.getDay()]+'</div>'
          +'<div style="font-size:1.2rem;margin-bottom:3px;">'+wmoIcon(daily.weathercode[i])+'</div>'
          +'<div style="font-size:0.78rem;font-weight:700;color:#fff;">'+Math.round(daily.temperature_2m_max[i])+'°</div>'
          +'<div style="font-size:0.72rem;color:#555;">'+Math.round(daily.temperature_2m_min[i])+'°</div>'
          +'</div>';
      }
      document.getElementById('wForecast').innerHTML = fHtml;
      document.getElementById('wetterWidget').style.display = 'block';
    }).catch(function(){});
})();
</script>


