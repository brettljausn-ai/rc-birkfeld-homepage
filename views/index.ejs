<%- include('partials/head', { title: 'RC ASVÖ Birkfeld – Radsportverein im Joglland', description: 'Radsportverein RC ASVÖ Birkfeld – Rennrad, MTB und Gravel im Joglland, Oststeiermark. Wöchentliche Ausfahrten, Jugendteam und Rennsport seit 1993.' }) %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SportsClub",
  "name": "RC ASVÖ Birkfeld",
  "alternateName": "Radsportclub ASVÖ Birkfeld",
  "description": "Radsportverein für Rennrad, MTB und Gravel im Joglland, Oststeiermark. Wöchentliche Ausfahrten, Jugendteam (U13–Junioren) und Rennsport seit 1993.",
  "url": "https://www.rc-birkfeld.at",
  "logo": "https://www.rc-birkfeld.at/images/rcbirkfeld-logo.png",
  "image": "https://www.rc-birkfeld.at/images/rcbirkfeld-logo.png",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Edelseestraße 27",
    "addressLocality": "Birkfeld",
    "postalCode": "8190",
    "addressRegion": "Steiermark",
    "addressCountry": "AT"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 47.3697, "longitude": 15.4989 },
  "sport": "Cycling",
  "foundingDate": "1993",
  "sameAs": ["https://www.strava.com/clubs/300701"]
}
</script>
<%- include('partials/nav') %>

<main id="top">

  <!-- HERO -->
  <section class="hero" style="padding-top:64px;min-height:640px;">
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#0A0A0A"/><stop offset="42%" stop-color="#2A2A2A"/><stop offset="66%" stop-color="#6B6B6B"/><stop offset="100%" stop-color="#D8D8D8"/>
          </linearGradient>
          <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.9"/><stop offset="60%" stop-color="#D8D8D8" stop-opacity="0.35"/><stop offset="100%" stop-color="#D8D8D8" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="ridgeFar" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#202020"/><stop offset="100%" stop-color="#161616"/>
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="1440" height="900" fill="url(#sky)"/>
        <circle class="sun" cx="1080" cy="430" r="230" fill="url(#sunGlow)"/>
        <circle class="sun" cx="1080" cy="430" r="62" fill="#FFFFFF"/>
        <path fill="url(#ridgeFar)" opacity="0.75" d="M0,520 L120,480 L260,505 L420,455 L560,490 L720,430 L880,470 L1040,410 L1200,460 L1360,420 L1440,450 L1440,900 L0,900 Z"/>
        <path fill="#1C1C1C" opacity="0.9" d="M0,600 L150,560 L320,590 L480,540 L650,575 L820,520 L1000,565 L1180,530 L1440,570 L1440,900 L0,900 Z"/>
        <path fill="#0A0A0A" d="M0,720 L200,650 L420,700 L620,620 L860,690 L1100,630 L1300,670 L1440,640 L1440,900 L0,900 Z"/>
        <path d="M120,900 C 260,760 340,760 460,690 C 560,635 640,660 700,610 C 760,560 820,600 900,560" fill="none" stroke="#E8E8E8" stroke-opacity="0.85" stroke-width="14" stroke-linecap="round" stroke-dasharray="2 26"/>
        <g class="rider" transform="translate(690,560) scale(1.05)">
          <ellipse cx="0" cy="46" rx="34" ry="6" fill="#000" opacity="0.18"/>
          <circle cx="-24" cy="34" r="16" fill="none" stroke="#0A0A0A" stroke-width="4.5"/>
          <circle cx="30" cy="34" r="16" fill="none" stroke="#0A0A0A" stroke-width="4.5"/>
          <path d="M-24,34 L4,10 L30,34 M4,10 L-2,-6 M4,10 L14,34 M-2,-6 L-24,34" stroke="#0A0A0A" stroke-width="4.5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M-2,-6 C -6,-22 -4,-34 6,-46 M6,-46 L20,-34 M6,-46 C 6,-46 -8,-40 -16,-22 L-24,-2" stroke="#0A0A0A" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="10" cy="-56" r="8" fill="#0A0A0A"/>
        </g>
        <g transform="translate(560,600) scale(0.72)" opacity="0.75">
          <circle cx="-24" cy="34" r="16" fill="none" stroke="#0A0A0A" stroke-width="5"/>
          <circle cx="30" cy="34" r="16" fill="none" stroke="#0A0A0A" stroke-width="5"/>
          <path d="M-24,34 L4,10 L30,34 M4,10 L-2,-6 M4,10 L14,34 M-2,-6 L-24,34" stroke="#0A0A0A" stroke-width="5" fill="none" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M-2,-6 C -4,-18 2,-22 8,-24 L20,-22" stroke="#0A0A0A" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="10" cy="-28" r="8" fill="#0A0A0A"/>
        </g>
      </svg>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow"><%= content.hero_eyebrow || 'Joglland · Oststeiermark · seit 1993' %></span>
      <h1><%= content.hero_title_line1 || 'Der Anstieg' %><br><%- (content.hero_title_line2 || 'gehört uns.').replace('uns.', '<span>uns.</span>') %></h1>
      <p class="lead"><%= content.hero_lead || '' %></p>
      <div class="hero-ctas">
        <a href="#mitglied" class="btn btn-primary">Join the Club</a>
        <a href="#angebote" class="btn btn-outline">Angebote ansehen</a>
      </div>
    </div>
    <div class="wrap profile-wrap">
      <svg class="profile-svg" viewBox="0 0 1180 220" preserveAspectRatio="none" role="img" aria-label="Höhenprofil Joglland mit Vereinskennzahlen">
        <defs>
          <linearGradient id="profileGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#4A5D3A" stop-opacity="0.55"/><stop offset="100%" stop-color="#4A5D3A" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path class="profile-fill" d="M0,190 L60,175 L140,150 L220,160 L300,110 L380,120 L460,70 L560,90 L650,40 L740,65 L830,95 L920,60 L1000,100 L1080,80 L1180,130 L1180,220 L0,220 Z"/>
        <path class="profile-line" d="M0,190 L60,175 L140,150 L220,160 L300,110 L380,120 L460,70 L560,90 L650,40 L740,65 L830,95 L920,60 L1000,100 L1080,80 L1180,130"/>
        <g class="profile-marker"><circle class="marker-dot" cx="140" cy="150" r="5"/><text class="marker-value" x="118" y="135">50+</text><text class="marker-label" x="108" y="200">Mitglieder</text></g>
        <g class="profile-marker"><circle class="marker-dot" cx="460" cy="70" r="5"/><text class="marker-value" x="418" y="52">U13–U19</text><text class="marker-label" x="418" y="200">Jugendteam</text></g>
        <g class="profile-marker"><circle class="marker-dot" cx="740" cy="65" r="5"/><text class="marker-value" x="700" y="48">Sa 13:00</text><text class="marker-label" x="700" y="200">Clubausfahrt</text></g>
        <g class="profile-marker"><circle class="marker-dot" cx="1000" cy="100" r="5"/><text class="marker-value" x="960" y="83">3 Disziplinen</text><text class="marker-label" x="960" y="200">Rennrad · MTB · Gravel</text></g>
      </svg>
    </div>
  </section>

  <!-- STATS -->
  <div class="stats">
    <div class="wrap">
      <div class="stat"><div class="num"><%= content.stats_1_num||'50+' %></div><div class="lbl"><%= content.stats_1_lbl||'Aktive Mitglieder' %></div></div>
      <div class="stat"><div class="num"><%= content.stats_2_num||'3' %></div><div class="lbl"><%= content.stats_2_lbl||'Disziplinen im Programm' %></div></div>
      <div class="stat"><div class="num"><%= content.stats_3_num||'1×' %></div><div class="lbl"><%= content.stats_3_lbl||'Ausfahrt pro Woche, fix' %></div></div>
      <div class="stat"><div class="num"><%= content.stats_4_num||'U13' %></div><div class="lbl"><%= content.stats_4_lbl||'Jüngste Jugendklasse' %></div></div>
    </div>
  </div>

  <!-- WETTER -->
  <div id="wetterWidget" style="display:none;background:#111;border-bottom:1px solid #1e1e1e;">
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;padding-top:18px;padding-bottom:18px;gap:24px;flex-wrap:wrap;">
      <div style="display:flex;align-items:center;gap:16px;">
        <div id="wCurIcon" style="font-size:2rem;line-height:1;"></div>
        <div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:0.65rem;text-transform:uppercase;letter-spacing:.1em;color:#555;margin-bottom:2px;">Birkfeld, jetzt</div>
          <div style="display:flex;align-items:baseline;gap:8px;">
            <span id="wCurTemp" style="font-family:'Big Shoulders Display',sans-serif;font-size:1.8rem;font-weight:900;color:#fff;line-height:1;"></span>
            <span id="wCurDesc" style="font-size:0.82rem;color:#888;"></span>
          </div>
          <div id="wCurMeta" style="font-size:0.72rem;color:#555;font-family:'IBM Plex Mono',monospace;margin-top:2px;"></div>
        </div>
      </div>
      <div id="wForecast" style="display:flex;gap:6px;"></div>
    </div>
  </div>

  <!-- VEREIN -->
  <section id="verein">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.verein_kicker||'Wer wir sind' %></span>
        <h2><%= content.verein_title||'Ein Dorfverein mit Rennlizenz.' %></h2>
        <p><%= content.verein_text||'Der RC ASVÖ Birkfeld ist Treffpunkt für Hobbyfahrer:innen und Rennsportler:innen aus dem Joglland.' %></p>
      </div>
    </div>
  </section>

  <!-- GALERIE -->
  <section id="galerie" style="background:var(--gravel-dark);">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.galerie_kicker||'Eindrücke' %></span>
        <h2><%= content.galerie_title||'Unterwegs im Joglland.' %></h2>
        <p><%= content.galerie_desc||'Bilder aus Ausfahrten, Rennen und dem Vereinsleben.' %></p>
      </div>
      <div class="gallery-grid" id="galerieGrid">
        <div class="gallery-item skel"></div>
        <div class="gallery-item skel"></div>
        <div class="gallery-item skel"></div>
        <div class="gallery-item skel"></div>
      </div>
    </div>
  </section>

  <!-- ANGEBOTE -->
  <section id="angebote" style="background:var(--gravel-dark);">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.angebote_kicker||'Angebote' %></span>
        <h2><%= content.angebote_title||'Drei Wege aufs Rad.' %></h2>
        <p><%= content.angebote_desc||'Egal ob erste Kurbelumdrehung oder nächster Startplatz – wähle, was zu dir passt.' %></p>
      </div>
      <div class="tabs" role="tablist">
        <button class="tab-btn active" role="tab" aria-selected="true" data-tab="jugend"><%= content.angebote_tab1_label||'Kids & Jugend' %></button>
        <button class="tab-btn" role="tab" aria-selected="false" data-tab="hobby"><%= content.angebote_tab2_label||'Hobby & Einsteiger' %></button>
        <button class="tab-btn" role="tab" aria-selected="false" data-tab="renn"><%= content.angebote_tab3_label||'Rennsport' %></button>
      </div>
      <%
        var _tabs=[
          {id:'jugend',n:1,dfltImg:'/images/galerie/foto-4.jpg'},
          {id:'hobby', n:2,dfltImg:''},
          {id:'renn',  n:3,dfltImg:'/images/galerie/foto-1.jpg'}
        ];
      %>
      <div class="tab-panels">
      <% _tabs.forEach(function(_t){ var _n=_t.n;
         var _list=(content['angebote_tab'+_n+'_list']||'').split('\n').filter(function(s){return s.trim();});
         var _img=content['angebote_tab'+_n+'_img']||_t.dfltImg; %>
        <div class="tab-panel <%= _t.id==='jugend'?'active':'' %>" data-panel="<%= _t.id %>">
          <div>
            <h3><%= content['angebote_tab'+_n+'_title']||'' %></h3>
            <p><%= content['angebote_tab'+_n+'_desc']||'' %></p>
            <ul><% _list.forEach(function(item){ %><li><%= item.trim() %></li><% }); %></ul>
          </div>
          <div class="tab-visual">
            <% if(_img){ %><img src="<%= _img %>" alt="<%= content['angebote_tab'+_n+'_title']||'' %>"><div class="overlay"></div><% } %>
            <span class="tag"><%= content['angebote_tab'+_n+'_tag']||'' %></span>
          </div>
        </div>
      <% }); %>
      </div>
    </div>
  </section>

  <!-- TERMINE -->
  <section id="termine">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.termine_kicker||'Termine' %></span>
        <h2><%= content.termine_title||'Was als Nächstes ansteht.' %></h2>
      </div>
      <div class="events" id="termineList">
        <div class="event-row"><span class="skel" style="height:48px;width:60px;"></span><div style="flex:1;padding:0 24px;"><span class="skel" style="height:18px;width:55%;margin-bottom:8px;"></span><span class="skel" style="height:13px;width:35%;"></span></div><span class="skel" style="height:24px;width:90px;border-radius:12px;"></span></div>
        <div class="event-row"><span class="skel" style="height:48px;width:60px;"></span><div style="flex:1;padding:0 24px;"><span class="skel" style="height:18px;width:65%;margin-bottom:8px;"></span><span class="skel" style="height:13px;width:40%;"></span></div><span class="skel" style="height:24px;width:90px;border-radius:12px;"></span></div>
        <div class="event-row"><span class="skel" style="height:48px;width:60px;"></span><div style="flex:1;padding:0 24px;"><span class="skel" style="height:18px;width:50%;margin-bottom:8px;"></span><span class="skel" style="height:13px;width:30%;"></span></div><span class="skel" style="height:24px;width:90px;border-radius:12px;"></span></div>
      </div>
    </div>
  </section>

  <!-- BERICHTE -->
  <section id="berichte">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.berichte_kicker||'News & Berichte' %></span>
        <h2><%= content.berichte_title||'Was zuletzt passiert ist.' %></h2>
        <p><%= content.berichte_desc||'Rennberichte, Vereinsnachrichten und Rückblicke aus dem Vereinsleben.' %></p>
      </div>
      <div class="news-grid" id="newsGrid">
        <% for (var _si=0;_si<3;_si++) { %>
        <div class="news-card">
          <div class="news-card-img skel"></div>
          <div class="news-card-body">
            <span class="skel" style="height:12px;width:42%;margin-bottom:10px;"></span>
            <span class="skel" style="height:20px;width:82%;margin-bottom:10px;"></span>
            <span class="skel" style="height:13px;width:100%;margin-bottom:5px;"></span>
            <span class="skel" style="height:13px;width:88%;margin-bottom:5px;"></span>
            <span class="skel" style="height:13px;width:74%;margin-bottom:16px;"></span>
            <span class="skel" style="height:15px;width:38%;"></span>
          </div>
        </div>
        <% } %>
      </div>
      <div style="text-align:center;margin-top:36px;">
        <a href="/berichte" style="display:inline-flex;align-items:center;gap:8px;border:2px solid #1F7A34;padding:12px 28px;border-radius:8px;font-size:0.88rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#1F7A34;text-decoration:none;transition:background .15s,color .15s;" onmouseover="this.style.background='#1F7A34';this.style.color='#fff'" onmouseout="this.style.background='';this.style.color='#1F7A34'">Alle Berichte ansehen →</a>
      </div>
    </div>
  </section>

  <!-- STRAVA -->
  <section id="strava">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.strava_kicker||'Live von Strava' %></span>
        <h2><%= content.strava_title||'Unser Club, auf der Straße.' %></h2>
      </div>
      <div id="jahresrueckblick" style="display:none;background:linear-gradient(135deg,#0d1a0d 0%,#111 100%);border:1px solid #1e1e1e;border-radius:16px;padding:28px 32px;margin-bottom:24px;">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:0.68rem;text-transform:uppercase;letter-spacing:.12em;color:#4CAF50;font-weight:600;margin-bottom:6px;" id="jrLabel"></div>
        <h3 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1.6rem;color:#fff;margin-bottom:20px;line-height:1.1;">Was wir gemeinsam gefahren sind.</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:16px;margin-bottom:20px;" id="jrStats"></div>
        <div style="background:#0a0a0a;border-radius:10px;overflow:hidden;height:8px;margin-top:4px;" id="jrBarWrap" style="display:none;">
          <div id="jrBar" style="height:100%;background:linear-gradient(90deg,#1F7A34,#4CAF50);border-radius:10px;transition:width 1s ease;width:0%;"></div>
        </div>
        <div id="jrBarLabel" style="font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:#444;margin-top:6px;"></div>
      </div>

      <div class="strava-card" id="stravaCard">
        <div class="strava-card-main">
          <span class="skel" style="width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,0.09);flex-shrink:0;animation:skel-shine 1.5s linear infinite;"></span>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <span class="skel" style="height:20px;width:200px;background:rgba(255,255,255,0.09);animation:skel-shine 1.5s linear infinite;"></span>
            <span class="skel" style="height:14px;width:140px;background:rgba(255,255,255,0.09);animation:skel-shine 1.5s linear infinite;"></span>
          </div>
        </div>
        <div class="strava-stats">
          <div class="strava-stat"><span class="skel" style="height:38px;width:64px;background:rgba(255,255,255,0.09);margin-bottom:8px;animation:skel-shine 1.5s linear infinite;"></span><span class="skel" style="height:13px;width:110px;background:rgba(255,255,255,0.09);animation:skel-shine 1.5s linear infinite;"></span></div>
          <div class="strava-stat"><span class="skel" style="height:38px;width:48px;background:rgba(255,255,255,0.09);margin-bottom:8px;animation:skel-shine 1.5s linear infinite;"></span><span class="skel" style="height:13px;width:120px;background:rgba(255,255,255,0.09);animation:skel-shine 1.5s linear infinite;"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPONSOREN -->
  <% if (sponsors && sponsors.length > 0) { %>
  <section id="sponsoren" class="sponsors-section" style="overflow:hidden;">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker">Unsere Partner</span>
        <h2>Sponsoren.</h2>
      </div>
    </div>
    <div class="sponsors-marquee-wrap">
      <div class="sponsors-marquee">
        <% var allSponsors = sponsors.concat(sponsors); allSponsors.forEach(s => { %>
        <% if (s.website_url) { %>
        <a href="<%= s.website_url %>" target="_blank" rel="noopener" class="sponsor-tile" title="<%= s.name %>">
        <% } else { %>
        <div class="sponsor-tile">
        <% } %>
          <img src="<%= s.logo %>" alt="<%= s.name %>" loading="lazy" width="120" height="60">
        <% if (s.website_url) { %></a><% } else { %></div><% } %>
        <% }); %>
      </div>
    </div>
  </section>
  <style>
  .sponsors-marquee-wrap{width:100%;overflow:hidden;padding:20px 0 40px;}
  .sponsors-marquee{display:flex;gap:40px;width:max-content;animation:marquee-scroll 30s linear infinite;}
  .sponsors-marquee:hover{animation-play-state:paused;}
  @keyframes marquee-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
  .sponsor-tile{display:flex;align-items:center;justify-content:center;min-width:140px;height:70px;padding:10px 16px;background:#fff;border-radius:8px;flex-shrink:0;}
  .sponsor-tile img{max-width:120px;max-height:50px;object-fit:contain;display:block;}
  </style>
  <% } %>

  <!-- GAME -->
  <section id="spiel" style="padding:clamp(40px,6vw,64px) 0;">
    <div class="wrap">
      <div style="margin-bottom:20px;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:var(--rust);text-transform:uppercase;letter-spacing:.1em;font-weight:600;display:block;margin-bottom:8px;">Mini-Spiel</span>
          <h2 style="font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:clamp(1.8rem,4vw,2.4rem);line-height:1.05;color:var(--ink);">Bergabfahrt</h2>
        </div>
        <p style="font-size:0.82rem;color:#888;font-family:'IBM Plex Mono',monospace;padding-bottom:6px;">LEERTASTE&nbsp;/&nbsp;TIPPEN&nbsp;=&nbsp;SPRINGEN</p>
      </div>
      <canvas id="rcGame" style="display:block;width:100%;max-width:800px;border-radius:12px;cursor:pointer;touch-action:none;" aria-label="Bergabfahrt Spiel – Leertaste oder Tippen zum Springen"></canvas>
    </div>
  </section>

  <!-- JOIN -->
  <section id="mitglied" class="join">
    <div class="wrap">
      <div class="section-head fade-in">
        <span class="kicker"><%= content.join_kicker||'Community' %></span>
        <h2><%= content.join_title||'Join the Club.' %></h2>
        <p><%= content.join_intro||'Ein Formular, keine Wartezeit – wir melden uns innerhalb weniger Tage mit den nächsten Schritten.' %></p>
      </div>
      <div class="join-grid">
        <div class="join-info">
          <h3 style="font-size:1.4rem;">Was dabei ist</h3>
          <ul>
