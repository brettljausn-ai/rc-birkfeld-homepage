<meta name="apple-mobile-web-app-title" content="RC Birkfeld">
<link rel="manifest" href="/manifest.json">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<link rel="apple-touch-icon" href="/images/rcbirkfeld-logo.png">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/styles.css?v=<%= appVersion %>">
<%- typeof extraHead !== 'undefined' ? extraHead : '' %>
<script>
if('serviceWorker' in navigator){
  window.addEventListener('load', function(){
    navigator.serviceWorker.register('/sw.js').catch(function(){});
  });
}
</script>
</head>
