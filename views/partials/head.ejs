<meta property="og:locale" content="de_AT">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title || 'RC ASVÖ Birkfeld' %>">
<meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Radsportverein RC ASVÖ Birkfeld – Rennrad, MTB und Gravel im Joglland, Oststeiermark.' %>">
<meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : 'https://www.rc-birkfeld.at/images/rcbirkfeld-logo.png' %>">
<meta name="google-site-verification" content="dCbJdVEdNt165M3nIja2nb2pDDsS1rqKBPVI9K2SewU">
