<script>
const burger = document.getElementById('burgerBtn');
const navlinks = document.getElementById('navlinks');
if (burger) {
  burger.addEventListener('click', () => {
    const open = navlinks.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
  });
  navlinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navlinks.classList.remove('open');
    burger.setAttribute('aria-expanded', false);
  }));
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected','false'); });
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    btn.setAttribute('aria-selected','true');
    document.querySelector(`.tab-panel[data-panel="${btn.dataset.tab}"]`).classList.add('active');
  });
});

const fadeEls = document.querySelectorAll('.fade-in');
if (fadeEls.length) {
  const obs = new IntersectionObserver(entries => entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); }), { threshold: 0.1 });
  fadeEls.forEach(el => obs.observe(el));
}

(function(){
  const grid = document.querySelector('.gallery-grid');
  if(!grid) return;
  const items = grid.querySelectorAll('.gallery-item');
  let idx = 0, timer;
  function next(){ idx=(idx+1)%items.length; grid.scrollTo({left:idx*(items[0].offsetWidth+16),behavior:'smooth'}); }
  function start(){ timer=setInterval(next,3500); }
  function stop(){ clearInterval(timer); }
  start();
  grid.addEventListener('mouseenter',stop);
  grid.addEventListener('mouseleave',start);
  grid.addEventListener('touchstart',()=>stop(),{passive:true});
  grid.addEventListener('touchend',()=>start(),{passive:true});
  grid.addEventListener('scroll',()=>{ idx=Math.round(grid.scrollLeft/(items[0].offsetWidth+16))%items.length; },{passive:true});
})();
// ── Lightbox ──
(function(){
  var lb = document.getElementById('_lb');
  if(!lb) return;
  var lbImg = document.getElementById('_lbImg');
  var lbCap = document.getElementById('_lbCap');
  var lbCtr = document.getElementById('_lbCtr');
  var cur = 0;

  function getItems(){ return Array.from(document.querySelectorAll('.gallery-item')); }

  function show(items){
    var el = items[cur];
    var img = el.querySelector('img');
    lbImg.src = img ? img.src : '';
    var cap = el.querySelector('.gallery-caption');
    lbCap.textContent = cap ? cap.textContent : '';
    lbCtr.textContent = (cur+1)+' / '+items.length;
  }

  function open(idx){
    cur = idx;
    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    show(getItems());
  }

  function close(){
    lb.style.display = 'none';
    document.body.style.overflow = '';
  }

  function nav(dir){
    var items = getItems();
    cur = (cur + dir + items.length) % items.length;
    show(items);
  }

  document.addEventListener('click', function(e){
    var item = e.target.closest('.gallery-item');
    if(item){ var all = getItems(); open(all.indexOf(item)); }
  });

  lb.addEventListener('click', function(e){ if(e.target===lb) close(); });
  document.getElementById('_lbClose').addEventListener('click', close);
  document.getElementById('_lbPrev').addEventListener('click', function(){ nav(-1); });
  document.getElementById('_lbNext').addEventListener('click', function(){ nav(1); });
  document.addEventListener('keydown', function(e){
    if(lb.style.display!=='flex') return;
    if(e.key==='Escape') close();
    if(e.key==='ArrowLeft') nav(-1);
    if(e.key==='ArrowRight') nav(1);
  });
})();
</script>

<div id="_lb" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.93);z-index:9999;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;">
  <button id="_lbClose" aria-label="Schließen" style="position:absolute;top:14px;right:18px;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer;line-height:1;opacity:.7;padding:4px;">✕</button>
  <button id="_lbPrev" aria-label="Zurück" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.1);border:none;color:#fff;font-size:1.6rem;cursor:pointer;padding:14px 18px;border-radius:6px;line-height:1;">&#8592;</button>
  <button id="_lbNext" aria-label="Weiter" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.1);border:none;color:#fff;font-size:1.6rem;cursor:pointer;padding:14px 18px;border-radius:6px;line-height:1;">&#8594;</button>
  <div style="max-width:min(90vw,960px);text-align:center;">
    <img id="_lbImg" src="" alt="" style="max-width:100%;max-height:80vh;object-fit:contain;border-radius:6px;display:block;margin:0 auto;">
    <p id="_lbCap" style="color:#bbb;margin-top:12px;font-size:0.9rem;min-height:1.2em;"></p>
    <span id="_lbCtr" style="color:#555;font-family:'IBM Plex Mono',monospace;font-size:0.72rem;"></span>
  </div>
</div>
</body>
</html>
