<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= profileName %> – RC Birkfeld Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}

  .profil-wrap{max-width:640px;margin:0 auto;padding:32px 16px;}

  /* header */
  .profil-header{display:flex;align-items:flex-start;gap:22px;margin-bottom:32px;}
  .profil-avatar-img{width:84px;height:84px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid #222;}
  .profil-avatar-init{width:84px;height:84px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.7rem;font-weight:700;color:#fff;flex-shrink:0;}
  .profil-name{font-size:1.35rem;font-weight:700;margin-bottom:7px;line-height:1.2;}
  .profil-bio{color:#888;font-size:0.9rem;line-height:1.6;margin-bottom:10px;}
  .profil-meta{font-size:0.75rem;color:#444;font-family:'IBM Plex Mono',monospace;margin-bottom:10px;}
  .btn-edit{background:none;border:1px solid #2a2a2a;color:#888;padding:6px 16px;border-radius:20px;font-size:0.8rem;cursor:pointer;font-family:inherit;transition:border-color .15s,color .15s;}
  .btn-edit:hover{border-color:#444;color:#fff;}

  /* edit card */
  .edit-card{background:#141414;border:1px solid #1e1e1e;border-radius:12px;padding:20px;margin-bottom:28px;display:none;}
  .edit-card.open{display:block;}
  .field{margin-bottom:14px;}
  label{font-size:0.72rem;text-transform:uppercase;letter-spacing:.07em;color:#555;font-weight:600;display:block;margin-bottom:5px;}
  textarea,input[type=text]{width:100%;background:#0d0d0d;border:1px solid #2a2a2a;color:#E8E8E8;font-family:inherit;font-size:0.9rem;padding:10px 12px;border-radius:8px;outline:none;}
  textarea{resize:vertical;min-height:72px;}
  textarea:focus,input[type=text]:focus{border-color:#4CAF50;}
  .char-count{font-size:0.72rem;color:#444;font-family:'IBM Plex Mono',monospace;margin-top:3px;text-align:right;}
  .btn-save{background:#1F7A34;color:#fff;border:none;padding:8px 22px;border-radius:20px;font-size:0.85rem;font-weight:700;cursor:pointer;font-family:inherit;}
  .btn-save:hover{background:#145C27;}

  /* avatar drop zone */
  .avatar-drop{border:2px dashed #2a2a2a;border-radius:8px;padding:14px;text-align:center;color:#444;font-size:0.8rem;cursor:pointer;transition:border-color .15s,color .15s;}
  .avatar-drop.over{border-color:#4CAF50;color:#4CAF50;}
  .avatar-drop input[type=file]{display:none;}
  .avatar-drop-preview{display:none;margin-top:10px;position:relative;width:84px;margin-left:auto;margin-right:auto;}
  .avatar-drop-preview img{width:84px;height:84px;border-radius:50%;object-fit:cover;display:block;border:2px solid #222;}
  .avatar-drop-remove{position:absolute;top:-4px;right:-4px;background:rgba(0,0,0,.8);border:1px solid #333;color:#fff;border-radius:50%;width:22px;height:22px;cursor:pointer;font-size:0.85rem;line-height:22px;text-align:center;padding:0;}
  .upload-status{font-size:0.73rem;color:#555;margin-top:6px;font-family:'IBM Plex Mono',monospace;}
  @media(max-width:480px){.bike-fields{grid-template-columns:1fr 1fr!important;}}

  /* posts */
  .section-label{font-size:0.72rem;text-transform:uppercase;letter-spacing:.1em;color:#444;font-weight:700;padding-bottom:10px;border-bottom:1px solid #1a1a1a;margin-bottom:16px;}
  .post-card{background:#141414;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;margin-bottom:14px;}
  .post-img{width:100%;max-height:480px;object-fit:cover;display:block;}
  .post-img.has-body{border-bottom:1px solid #1e1e1e;}
  .post-body{padding:14px 16px;font-size:0.93rem;line-height:1.65;color:#D8D8D8;white-space:pre-wrap;word-break:break-word;}
  .post-footer{padding:8px 16px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #111;}
  .post-time{font-size:0.73rem;color:#444;font-family:'IBM Plex Mono',monospace;}
  .btn-del{background:none;border:none;color:#333;font-size:0.75rem;cursor:pointer;font-family:inherit;padding:4px 8px;border-radius:4px;}
  .btn-del:hover{color:#e57373;background:#1e1010;}
  .empty{text-align:center;color:#333;padding:60px 0;font-size:0.9rem;}
  .strava-card{background:#141414;border:1px solid #1e1e1e;border-radius:10px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;}
  .strava-icon{width:36px;height:36px;border-radius:8px;background:#FC4C02;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .strava-name{font-size:0.9rem;font-weight:600;color:#E8E8E8;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .strava-stats{display:flex;gap:16px;flex-wrap:wrap;}
  .strava-stat{font-size:0.75rem;color:#555;font-family:'IBM Plex Mono',monospace;}
  .strava-stat span{color:#aaa;font-weight:600;}
  .strava-date{font-size:0.72rem;color:#333;font-family:'IBM Plex Mono',monospace;margin-left:auto;white-space:nowrap;align-self:flex-start;padding-top:2px;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="profil-wrap">

  <!-- ── Profile header ── -->
  <div class="profil-header">
    <% if (profile && profile.avatar_url) { %>
      <img class="profil-avatar-img" src="<%= profile.avatar_url %>" alt="" onerror="this.style.display='none'">
    <% } else { %>
      <div class="profil-avatar-init" style="background:<%= avatarColor(profileName) %>;"><%= initials(profileName) %></div>
    <% } %>
    <div style="flex:1;min-width:0;">
      <div class="profil-name"><%= profileName %></div>
      <% if (profile && profile.bio) { %>
        <p class="profil-bio"><%= profile.bio %></p>
      <% } else if (isOwnProfile) { %>
        <p class="profil-bio" style="color:#333;font-style:italic;">Noch keine Info – füge eine kurze Beschreibung hinzu.</p>
      <% } %>
      <div class="profil-meta"><%= posts.length %> <%= posts.length === 1 ? 'Beitrag' : 'Beiträge' %></div>
      <% if (isOwnProfile) { %>
        <button class="btn-edit" id="toggleEditBtn">Profil bearbeiten</button>
      <% } %>
    </div>
  </div>

  <!-- ── Edit form (own profile only) ── -->
  <% if (isOwnProfile) { %>
  <div class="edit-card" id="editCard">
    <form method="POST" action="/club/profil/edit" id="profilForm">
      <div class="field">
        <label>Kurze Info <span style="font-weight:400;color:#333;">(max. 300 Zeichen)</span></label>
        <textarea name="bio" id="bioField" maxlength="300"><%= (profile && profile.bio) || '' %></textarea>
        <div class="char-count"><span id="charCount"><%= ((profile && profile.bio) || '').length %></span>/300</div>
      </div>
      <div class="field">
        <label>Profilbild</label>
        <div class="avatar-drop" id="avatarDrop">
          <input type="file" id="avatarFile" accept="image/*">
          ↑ Bild ablegen oder klicken
          <div class="avatar-drop-preview" id="avatarPreview" <% if(profile && profile.avatar_url){%>style="display:block"<%}%>>
            <img id="avatarPreviewImg" src="<%= (profile && profile.avatar_url) || '' %>" alt="">
            <button type="button" class="avatar-drop-remove" id="avatarRemove">×</button>
          </div>
          <div class="upload-status" id="avatarStatus"></div>
        </div>
        <input type="hidden" name="avatar_url" id="avatarUrlField" value="<%= (profile && profile.avatar_url) || '' %>">
      </div>
      <div class="field bike-fields" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
        <div>
          <label>Hersteller</label>
          <input type="text" name="bike_brand" maxlength="100" value="<%= (profile && profile.bike_brand) || '' %>" placeholder="z.B. Trek">
        </div>
        <div>
          <label>Modell</label>
          <input type="text" name="bike_model" maxlength="100" value="<%= (profile && profile.bike_model) || '' %>" placeholder="z.B. Domane SL6">
        </div>
        <div>
          <label>Größe</label>
          <input type="text" name="bike_size" maxlength="20" value="<%= (profile && profile.bike_size) || '' %>" placeholder="z.B. 56 cm">
        </div>
      </div>
      <div class="field">
        <label>Mein Rad <span style="font-weight:400;color:#333;">– Foto</span></label>
        <div class="avatar-drop" id="bikeDrop" style="border-radius:8px;">
          <input type="file" id="bikeFile" accept="image/*">
          ↑ Bild ablegen oder klicken
          <div class="bike-drop-preview" id="bikePreview" <% if(profile && profile.bike_url){%>style="display:block"<%}%>>
            <img id="bikePreviewImg" src="<%= (profile && profile.bike_url) || '' %>" alt="" style="width:100%;max-height:200px;object-fit:cover;border-radius:6px;display:block;margin-top:10px;">
            <button type="button" class="avatar-drop-remove" id="bikeRemove" style="top:14px;right:4px;left:auto;">×</button>
          </div>
          <div class="upload-status" id="bikeStatus"></div>
        </div>
        <input type="hidden" name="bike_url" id="bikeUrlField" value="<%= (profile && profile.bike_url) || '' %>">
      </div>
      <div class="field">
        <label>Strava-Profil <span style="font-weight:400;color:#333;">– URL oder Athleten-ID (strava.com/athletes/<em>12345678</em>)</span></label>
        <input type="text" name="strava_athlete_id" value="<%= (profile && profile.strava_athlete_id) || '' %>" placeholder="https://www.strava.com/athletes/12345678">
      </div>
      <button type="submit" class="btn-save">Speichern</button>
    </form>
  </div>
  <% } %>

  <!-- ── Bike ── -->
  <% var _hasBike = profile && (profile.bike_url || profile.bike_brand || profile.bike_model || profile.bike_size); %>
  <% if (_hasBike) { %>
  <div style="margin-bottom:28px;">
    <div class="section-label">Mein Rad</div>
    <div style="background:#141414;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;">
      <% if (profile.bike_url) { %>
        <img src="<%= profile.bike_url %>" alt="Rad von <%= profileName %>" style="width:100%;max-height:420px;object-fit:cover;display:block;" loading="lazy" onerror="this.style.display='none'">
      <% } %>
      <% if (profile.bike_brand || profile.bike_model || profile.bike_size) { %>
        <div style="padding:14px 16px;display:flex;gap:24px;flex-wrap:wrap;">
          <% if (profile.bike_brand) { %>
            <div><div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:.08em;color:#444;font-weight:700;margin-bottom:3px;">Hersteller</div><div style="font-size:0.9rem;color:#ccc;"><%= profile.bike_brand %></div></div>
          <% } %>
          <% if (profile.bike_model) { %>
            <div><div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:.08em;color:#444;font-weight:700;margin-bottom:3px;">Modell</div><div style="font-size:0.9rem;color:#ccc;"><%= profile.bike_model %></div></div>
          <% } %>
          <% if (profile.bike_size) { %>
            <div><div style="font-size:0.68rem;text-transform:uppercase;letter-spacing:.08em;color:#444;font-weight:700;margin-bottom:3px;">Größe</div><div style="font-size:0.9rem;color:#ccc;"><%= profile.bike_size %></div></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- ── Strava ── -->
  <% if (stravaActivities && stravaActivities.length) { %>
  <div style="margin-bottom:28px;">
    <div class="section-label" style="display:flex;align-items:center;gap:8px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="#FC4C02"><path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
      Strava Aktivitäten
    </div>
    <%
    function fmtDist(m) { return (m/1000).toFixed(1)+' km'; }
    function fmtTime(s) { var h=Math.floor(s/3600),m=Math.floor((s%3600)/60); return h>0?h+'h '+m+'min':m+' min'; }
    function fmtElev(m) { return Math.round(m)+' hm'; }
    function sportIcon(t) {
      var s = (t||'').toLowerCase();
      if (s.includes('ride') || s.includes('cycling')) return '<path d="M17 5a2 2 0 100-4 2 2 0 000 4zm-5 4l-3 6h2l1-2h4l1 2h2l-3-6h-4zm-9 5a4 4 0 108 0 4 4 0 00-8 0zm14 0a4 4 0 108 0 4 4 0 00-8 0z" fill="white"/>';
      if (s.includes('run')) return '<path d="M13.5 5.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7" fill="white"/>';
      return '<path d="M12 2a10 10 0 110 20A10 10 0 0112 2zm0 4a1 1 0 100 2 1 1 0 000-2zm1 3h-2v6h2V9z" fill="white"/>';
    }
    %>
    <% stravaActivities.forEach(function(a) {
      var dateStr = a.start_date ? new Date(a.start_date).toLocaleDateString('de-AT',{day:'2-digit',month:'2-digit',year:'numeric'}) : '';
      var athleteUrl = 'https://www.strava.com/athletes/' + (profile.strava_athlete_id);
    %>
    <a href="<%= athleteUrl %>" target="_blank" rel="noopener" class="strava-card" style="text-decoration:none;">
      <div class="strava-icon">
        <svg width="18" height="18" viewBox="0 0 24 24"><%- sportIcon(a.sport_type || a.type) %></svg>
      </div>
      <div style="flex:1;min-width:0;">
        <div class="strava-name"><%= a.name %></div>
        <div class="strava-stats">
          <% if (a.distance > 0) { %><div class="strava-stat"><span><%= fmtDist(a.distance) %></span></div><% } %>
          <% if (a.moving_time > 0) { %><div class="strava-stat"><span><%= fmtTime(a.moving_time) %></span></div><% } %>
          <% if (a.total_elevation_gain > 0) { %><div class="strava-stat">↑ <span><%= fmtElev(a.total_elevation_gain) %></span></div><% } %>
        </div>
      </div>
      <div class="strava-date"><%= dateStr %></div>
    </a>
    <% }); %>
  </div>
  <% } else if (profile && profile.strava_athlete_id) { %>
  <div style="margin-bottom:28px;">
    <div class="section-label">Strava Aktivitäten</div>
    <div style="color:#333;font-size:0.85rem;padding:16px 0;">Noch keine Aktivitäten im Club-Feed gefunden.</div>
  </div>
  <% } %>

  <!-- ── Posts ── -->
  <div class="section-label">Beiträge · <%= posts.length %></div>

  <% if (!posts.length) { %>
    <div class="empty">Noch keine Beiträge.</div>
  <% } %>

  <% posts.forEach(function(p) {
    var ts = new Date(p.created_at);
    var dateStr = ts.toLocaleDateString('de-AT', {day:'2-digit', month:'2-digit', year:'numeric'});
  %>
  <div class="post-card">
    <% if (p.image_url) { %>
      <img class="post-img<%= p.content ? ' has-body' : '' %>" src="<%= p.image_url %>" alt="" loading="lazy" onerror="this.style.display='none'">
    <% } %>
    <% if (p.content) { %>
      <div class="post-body"><%= p.content %></div>
    <% } %>
    <div class="post-footer">
      <span class="post-time"><%= dateStr %></span>
      <% if (isOwnProfile) { %>
        <form method="POST" action="/club/post/<%= p.id %>/delete" onsubmit="return confirm('Beitrag löschen?')">
          <button class="btn-del" type="submit">Löschen</button>
        </form>
      <% } %>
    </div>
  </div>
  <% }); %>

</div>
<script>
/* Toggle edit card */
var toggleBtn = document.getElementById('toggleEditBtn');
var editCard  = document.getElementById('editCard');
if (toggleBtn) {
  toggleBtn.addEventListener('click', function() {
    editCard.classList.toggle('open');
    toggleBtn.textContent = editCard.classList.contains('open') ? 'Schließen' : 'Profil bearbeiten';
  });
}

/* Char counter */
var bioField = document.getElementById('bioField');
var charCount = document.getElementById('charCount');
if (bioField) {
  bioField.addEventListener('input', function() {
    charCount.textContent = bioField.value.length;
  });
}

function initDropZone(dropId, fileId, previewId, previewImgId, removeId, hiddenId, statusId) {
  var drop    = document.getElementById(dropId);
  var file    = document.getElementById(fileId);
  var preview = document.getElementById(previewId);
  var previewImg = document.getElementById(previewImgId);
  var remove  = document.getElementById(removeId);
  var hidden  = document.getElementById(hiddenId);
  var status  = document.getElementById(statusId);
  if (!drop) return;

  drop.addEventListener('click', function(e) { if (e.target !== remove) file.click(); });
  drop.addEventListener('dragover', function(e) { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', function() { drop.classList.remove('over'); });
  drop.addEventListener('drop', function(e) {
    e.preventDefault(); drop.classList.remove('over');
    if (e.dataTransfer.files[0]) upload(e.dataTransfer.files[0]);
  });
  file.addEventListener('change', function() { if (file.files[0]) upload(file.files[0]); });
  remove.addEventListener('click', function(e) {
    e.stopPropagation();
    hidden.value = ''; previewImg.src = ''; preview.style.display = 'none'; file.value = ''; status.textContent = '';
  });

  function upload(f) {
    if (!f.type.match(/^image\//)) { status.textContent = 'Nur Bilder erlaubt.'; return; }
    previewImg.src = URL.createObjectURL(f);
    preview.style.display = 'block';
    status.textContent = 'Wird hochgeladen…';
    var fd = new FormData(); fd.append('image', f);
    fetch('/club/upload-image', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.url) { hidden.value = data.url; status.textContent = 'Bild bereit.'; }
        else { status.textContent = 'Fehler beim Hochladen.'; preview.style.display = 'none'; }
      })
      .catch(function() { status.textContent = 'Fehler beim Hochladen.'; });
  }
}

initDropZone('avatarDrop','avatarFile','avatarPreview','avatarPreviewImg','avatarRemove','avatarUrlField','avatarStatus');
initDropZone('bikeDrop','bikeFile','bikePreview','bikePreviewImg','bikeRemove','bikeUrlField','bikeStatus');
</script>
</body>
</html>
