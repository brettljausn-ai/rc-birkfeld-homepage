<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Termine – RC Birkfeld Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
  /* termine */
  .termine-wrap{max-width:720px;margin:0 auto;padding:24px 16px;}
  .page-title{font-family:'Big Shoulders Display',sans-serif;font-size:1.8rem;font-weight:900;margin-bottom:4px;}
  .page-sub{font-size:0.82rem;color:#555;margin-bottom:24px;font-family:'IBM Plex Mono',monospace;}
  .event-card{background:#141414;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;margin-bottom:16px;}
  .event-card-top{display:grid;grid-template-columns:80px 1fr;}
  .event-cal{background:#1a1a1a;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px 8px;border-right:1px solid #1e1e1e;}
  .event-cal .mon{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;text-transform:uppercase;letter-spacing:.1em;color:#4CAF50;font-weight:600;}
  .event-cal .day{font-family:'Big Shoulders Display',sans-serif;font-size:2.4rem;font-weight:900;line-height:1;color:#fff;}
  .event-cal .yr{font-family:'IBM Plex Mono',monospace;font-size:0.65rem;color:#444;}
  .event-body{padding:18px 20px;}
  .event-tag{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;text-transform:uppercase;letter-spacing:.07em;color:#555;margin-bottom:5px;display:block;}
  .event-title{font-size:1.1rem;font-weight:700;margin-bottom:4px;}
  .event-loc{font-size:0.82rem;color:#666;margin-bottom:10px;}
  .detail-link{font-size:0.78rem;color:#555;display:inline-block;margin-top:2px;}
  .detail-link:hover{color:#4CAF50;}
  .rsvp-section{border-top:1px solid #1e1e1e;padding:16px 20px;}
  .rsvp-counts{font-family:'IBM Plex Mono',monospace;font-size:0.75rem;color:#444;margin-bottom:10px;}
  .rsvp-btns{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;}
  .btn-yes,.btn-no{display:flex;align-items:center;gap:6px;padding:8px 18px;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer;font-family:inherit;border:2px solid transparent;transition:all .15s;}
  .btn-yes{background:#0d2a10;color:#4CAF50;border-color:#1F7A34;}
  .btn-yes:hover,.btn-yes.active{background:#1F7A34;color:#fff;}
  .btn-no{background:#2a0d0d;color:#e57373;border-color:#5c2020;}
  .btn-no:hover,.btn-no.active{background:#c62828;color:#fff;}
  .rsvp-attendees{display:flex;flex-wrap:wrap;gap:8px;}
  .attendee{display:flex;align-items:center;gap:5px;background:#1a1a1a;border-radius:20px;padding:3px 10px 3px 3px;font-size:0.78rem;}
  .att-av{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.58rem;font-weight:700;color:#fff;}
  .attendee.yes-att .att-name{color:#4CAF50;}
  .attendee.no-att{opacity:.65;}
  .empty{text-align:center;color:#333;padding:60px 0;font-size:0.9rem;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="termine-wrap">
  <h1 class="page-title">Termine</h1>
  <p class="page-sub">Sag Bescheid ob du dabei bist.</p>

  <% if (termine.length === 0) { %>
  <div class="empty">Keine bevorstehenden Termine.</div>
  <% } else { termine.forEach(function(t) {
    var d = new Date(t.date);
    var mon = d.toLocaleDateString('de-AT',{month:'short'}).toUpperCase().replace('.','');
    var day = d.getDate();
    var yr  = d.getFullYear();
  %>
  <div class="event-card">
    <div class="event-card-top">
      <div class="event-cal">
        <div class="mon"><%= mon %></div>
        <div class="day"><%= day %></div>
        <div class="yr"><%= yr %></div>
      </div>
      <div class="event-body">
        <span class="event-tag"><%= t.tag || 'Vereinsrennen' %></span>
        <div class="event-title"><%= t.title %></div>
        <% if (t.location) { %><div class="event-loc"><%= t.location %></div><% } %>
        <% if (t.detail_url) { %><a href="<%= t.detail_url %>" class="detail-link" target="<%= t.detail_url.startsWith('http')?'_blank':'_self' %>">Mehr Infos →</a><% } %>
      </div>
    </div>
    <div class="rsvp-section">
      <div class="rsvp-counts"><%= t.yes_count %> Dabei · <%= t.no_count %> Absagen</div>
      <div class="rsvp-btns">
        <form method="POST" action="/club/rsvp/<%= t.id %>">
          <input type="hidden" name="status" value="yes">
          <button type="submit" class="btn-yes <%= t.my_status==='yes'?'active':'' %>">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Ich bin dabei<% if(t.my_status==='yes'){%> ✓<%}%>
          </button>
        </form>
        <form method="POST" action="/club/rsvp/<%= t.id %>">
          <input type="hidden" name="status" value="no">
          <button type="submit" class="btn-no <%= t.my_status==='no'?'active':'' %>">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            Kann nicht<% if(t.my_status==='no'){%> ✗<%}%>
          </button>
        </form>
      </div>
      <% if (t.yes_names.length > 0 || t.no_names.length > 0) { %>
      <div class="rsvp-attendees">
        <% t.yes_names.forEach(function(name){ %>
        <div class="attendee yes-att">
          <div class="att-av" style="background:<%= avatarColor(name) %>;"><%= initials(name) %></div>
          <span class="att-name"><%= name %></span>
        </div>
        <% }); t.no_names.forEach(function(name){ %>
        <div class="attendee no-att">
          <div class="att-av" style="background:#3a3a3a;"><%= initials(name) %></div>
          <span class="att-name"><%= name %></span>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
  <% }); } %>
</div>
</body>
</html>
