<% function initials(name) {
  return name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
}
const avatarColors = ['#1F7A34','#1565C0','#7B1FA2','#E65100','#00838F','#C62828'];
function avatarColor(name) {
  let h = 0; for (const c of name) h = (h*31+c.charCodeAt(0))&0xFFFF;
  return avatarColors[h % avatarColors.length];
}
%>
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;gap:0;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;}
  .ch-tab:hover{color:#aaa;}
  .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-tab svg{opacity:.6;}
  .ch-tab.active svg{opacity:1;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;white-space:nowrap;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">

<div class="ch">
  <a href="/club" class="ch-brand">RC CLUB</a>
  <div class="ch-tabs">
    <a href="/club" class="ch-tab <%= page==='feed'?'active':'' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="8" height="8" rx="1.5" fill="currentColor"/><rect x="13" y="3" width="8" height="8" rx="1.5" fill="currentColor"/><rect x="3" y="13" width="8" height="8" rx="1.5" fill="currentColor"/><rect x="13" y="13" width="8" height="8" rx="1.5" fill="currentColor"/></svg>
      Feed
    </a>
    <a href="/club/termine" class="ch-tab <%= page==='termine'?'active':'' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2"/><path d="M3 10h18" stroke="currentColor" stroke-width="2"/><path d="M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Termine
    </a>
    <a href="/club/chat" class="ch-tab <%= page==='chat'?'active':'' %>">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      Chat
    </a>
  </div>
  <div class="ch-right">
    <div class="ch-avatar" style="background:<%= avatarColor(memberName) %>;"><%= initials(memberName) %></div>
    <span class="ch-name"><%= memberName %></span>
    <a href="/club/logout" class="ch-logout">Abmelden</a>
  </div>
</div>
