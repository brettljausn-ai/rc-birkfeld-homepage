<script>
(function(){
  var btn      = document.getElementById('chHamburger');
  var backdrop = document.getElementById('chBackdrop');
  var drawer   = document.getElementById('chDrawer');
  var closeBtn = document.getElementById('chDrawerClose');
  if (!btn) return;
  function open()  { drawer.classList.add('open');  backdrop.classList.add('open');  document.body.style.overflow='hidden'; }
  function close() { drawer.classList.remove('open'); backdrop.classList.remove('open'); document.body.style.overflow=''; }
  btn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
})();
</script>
