<style>
.ch-hamburger{display:none;background:none;border:none;color:#aaa;cursor:pointer;padding:6px;line-height:0;flex-shrink:0;}
.ch-hamburger:hover{color:#fff;}
.ch-drawer-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:300;}
.ch-drawer-backdrop.open{display:block;}
.ch-drawer{position:fixed;top:0;left:-290px;width:280px;height:100%;background:#111;border-right:1px solid #1e1e1e;z-index:301;display:flex;flex-direction:column;transition:left .22s ease;overflow-y:auto;}
.ch-drawer.open{left:0;}
.ch-dhead{padding:14px 18px;border-bottom:1px solid #1e1e1e;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.ch-dhead-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1.05rem;color:#4CAF50;letter-spacing:.06em;}
.ch-dclose{background:none;border:none;color:#555;font-size:1.4rem;cursor:pointer;line-height:1;padding:0;}
.ch-dclose:hover{color:#fff;}
.ch-dnav{padding:6px 0;flex:1;}
.ch-dlink{display:flex;align-items:center;gap:13px;padding:11px 18px;color:#666;font-size:0.88rem;font-weight:600;text-decoration:none;transition:color .1s,background .1s;border-left:3px solid transparent;}
.ch-dlink:hover{color:#ccc;background:#161616;}
.ch-dlink.active{color:#4CAF50;border-left-color:#4CAF50;background:#141414;}
.ch-dlink svg{flex-shrink:0;opacity:.7;}
.ch-dlink.active svg{opacity:1;}
.ch-dfooter{padding:14px 18px;border-top:1px solid #1e1e1e;display:flex;flex-direction:column;gap:10px;}
.ch-dfooter a{display:flex;align-items:center;gap:10px;color:#555;font-size:0.83rem;font-weight:600;text-decoration:none;padding:4px 0;}
.ch-dfooter a:hover{color:#aaa;}
@media(max-width:640px){
  .ch-tabs{display:none !important;}
  .ch-right .ch-logout,.ch-right .ch-profile-link .ch-name{display:none;}
  .ch-hamburger{display:flex !important;}
  .ch-brand{margin-right:0;}
}
</style>
<div class="ch">
  <a href="/club" class="ch-brand">RC CLUB</a>
  <div class="ch-tabs">
    <a href="/club" class="ch-tab <%= page==='feed'?'active':'' %>">
