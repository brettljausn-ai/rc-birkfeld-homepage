<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Club-Login – RC Birkfeld</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;700&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0A0A0A;color:#fff;font-family:'Public Sans',system-ui,sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px;}
  .box{background:#141414;border:1px solid #222;border-radius:12px;padding:40px 36px;width:100%;max-width:400px;}
  .brand{display:flex;align-items:center;gap:10px;margin-bottom:28px;}
  .brand-name{font-family:'Big Shoulders Display',sans-serif;font-size:1.2rem;font-weight:900;color:#4CAF50;letter-spacing:0.04em;}
  h1{font-size:1.5rem;font-weight:700;margin-bottom:6px;}
  .sub{color:#666;font-size:0.88rem;margin-bottom:24px;}
  .error{background:rgba(229,57,53,0.12);border:1px solid rgba(229,57,53,0.3);color:#ff6b6b;padding:10px 14px;border-radius:6px;margin-bottom:18px;font-size:0.88rem;}
  .btn-sso{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px;border-radius:6px;font-size:0.92rem;font-weight:600;cursor:pointer;text-decoration:none;border:1px solid #2a2a2a;margin-bottom:10px;transition:border-color .15s,background .15s;color:#fff;background:#1a1a1a;}
  .btn-google:hover{background:#1e1e1e;border-color:#4285F4;}
  .divider{display:flex;align-items:center;gap:12px;margin:20px 0;color:#333;font-size:0.78rem;}
  .divider::before,.divider::after{content:'';flex:1;height:1px;background:#222;}
  label{display:block;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.07em;color:#555;font-weight:700;margin-bottom:5px;}
  input{width:100%;background:#0A0A0A;border:1px solid #2a2a2a;color:#fff;padding:10px 13px;border-radius:6px;font-size:0.92rem;margin-bottom:14px;font-family:inherit;}
  input:focus{outline:2px solid #4CAF50;border-color:#4CAF50;}
  .btn-main{width:100%;background:#1F7A34;color:#fff;border:none;padding:12px;border-radius:6px;font-size:1rem;font-weight:700;cursor:pointer;font-family:inherit;}
  .btn-main:hover{background:#145C27;}
  .bottom-links{display:flex;justify-content:center;margin-top:16px;font-size:0.85rem;color:#555;}
  .bottom-links a{color:#4CAF50;text-decoration:none;font-weight:600;}
  .bottom-links a:hover{text-decoration:underline;}
</style>
</head>
<body>
<div class="box">
  <div class="brand">
    <svg width="28" height="28" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#1F7A34"/><path d="M8 12l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
    <span class="brand-name">RC BIRKFELD</span>
  </div>
  <h1>Mitglieder-Bereich</h1>
  <p class="sub">Willkommen zurück.</p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <% if (googleEnabled) { %>
  <a href="/club/auth/google" class="btn-sso btn-google">
    <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
    Mit Google anmelden
  </a>
  <div class="divider">oder mit E-Mail</div>
  <% } %>

  <form method="POST" action="/club/login/email">
    <label>E-Mail</label>
    <input type="email" name="email" placeholder="deine@email.com" required autocomplete="email">
    <label>Passwort</label>
    <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
    <button class="btn-main" type="submit">Anmelden →</button>
  </form>

  <div class="bottom-links">
    Noch kein Konto?&nbsp;<a href="/club/register">Jetzt registrieren →</a>
  </div>
</div>
</body>
</html>
