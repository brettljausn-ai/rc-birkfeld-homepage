<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Challenge – RC Birkfeld Club</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;overflow-x:auto;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;white-space:nowrap;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  .ch-profile-link{display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;}

  /* challenge */
  .wrap{max-width:680px;margin:0 auto;padding:24px 16px;}
  .page-title{font-family:'Big Shoulders Display',sans-serif;font-size:1.8rem;font-weight:900;margin-bottom:4px;}
  .page-sub{font-size:0.82rem;color:#555;margin-bottom:28px;font-family:'IBM Plex Mono',monospace;}
  .no-challenge{text-align:center;padding:60px 20px;color:#444;}
  .no-challenge svg{display:block;margin:0 auto 16px;color:#2a2a2a;}
  .no-challenge p{font-size:0.9rem;}
  .challenge-hero{background:linear-gradient(135deg,#0d2a10 0%,#1a1a0d 100%);border:1px solid #1F7A34;border-radius:16px;padding:28px 24px;margin-bottom:24px;position:relative;overflow:hidden;}
  .challenge-hero::before{content:'';position:absolute;top:-20px;right:-20px;width:120px;height:120px;border-radius:50%;background:rgba(76,175,80,.06);}
  .ch-kicker{font-family:'IBM Plex Mono',monospace;font-size:0.7rem;text-transform:uppercase;letter-spacing:.1em;color:#4CAF50;font-weight:600;margin-bottom:8px;}
  .ch-title{font-family:'Big Shoulders Display',sans-serif;font-size:clamp(1.4rem,4vw,2rem);font-weight:900;line-height:1.1;margin-bottom:10px;color:#fff;}
  .ch-desc{font-size:0.88rem;color:#aaa;line-height:1.6;margin-bottom:14px;}
  .ch-dates{display:flex;gap:20px;flex-wrap:wrap;}
  .ch-date{font-family:'IBM Plex Mono',monospace;font-size:0.72rem;color:#555;}
  .ch-date span{color:#888;}
  .leaderboard{background:#111;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;}
  .lb-header{padding:14px 20px;border-bottom:1px solid #1e1e1e;display:flex;align-items:center;justify-content:space-between;}
  .lb-title{font-family:'IBM Plex Mono',monospace;font-size:0.72rem;text-transform:uppercase;letter-spacing:.1em;color:#555;font-weight:600;}
  .lb-strava-link{font-size:0.75rem;color:#e05729;font-weight:600;}
  .lb-strava-link:hover{color:#f06040;}
  .lb-row{display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:12px;padding:12px 20px;border-bottom:1px solid #131313;}
  .lb-row:last-child{border-bottom:none;}
  .lb-row.top-1{background:#0d1a0d;}
  .lb-rank{font-family:'Big Shoulders Display',sans-serif;font-size:1.4rem;font-weight:900;color:#333;text-align:center;}
  .lb-row.top-1 .lb-rank{color:#4CAF50;}
  .lb-row.top-2 .lb-rank{color:#888;}
  .lb-row.top-3 .lb-rank{color:#c0884a;}
  .lb-name{font-size:0.9rem;font-weight:600;}
  .lb-time{font-family:'IBM Plex Mono',monospace;font-size:0.85rem;color:#4CAF50;font-weight:600;white-space:nowrap;}
  .lb-row.top-1 .lb-time{font-size:0.95rem;}
  .lb-sub{font-size:0.72rem;color:#444;margin-top:2px;}
  .trophy{font-size:1.1rem;}
  .empty-lb{text-align:center;padding:40px;color:#333;font-size:0.88rem;}
  .prize-banner{background:#141414;border:1px solid #2a2a2a;border-radius:10px;padding:14px 18px;margin-top:16px;display:flex;align-items:center;gap:12px;font-size:0.85rem;color:#888;}
  .prize-banner svg{color:#FFD700;flex-shrink:0;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="wrap">
  <h1 class="page-title">Vereinschallenge</h1>
  <p class="page-sub">Wer ist der Schnellste auf dem Segment?</p>

  <% if (!challenge) { %>
  <div class="no-challenge">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <p>Derzeit läuft keine Challenge.<br>Der Admin legt die nächste im Admin-Bereich fest.</p>
  </div>
  <% } else { %>

  <div class="challenge-hero">
    <div class="ch-kicker">Aktuelle Challenge</div>
    <div class="ch-title"><%= challenge.title %></div>
    <% if (challenge.description) { %>
    <div class="ch-desc"><%= challenge.description %></div>
    <% } %>
    <div class="ch-dates">
      <% if (challenge.start_date) { %>
      <div class="ch-date">Start: <span><%= new Date(challenge.start_date).toLocaleDateString('de-AT',{day:'2-digit',month:'long',year:'numeric'}) %></span></div>
      <% } %>
      <% if (challenge.end_date) { %>
      <div class="ch-date">Ende: <span><%= new Date(challenge.end_date).toLocaleDateString('de-AT',{day:'2-digit',month:'long',year:'numeric'}) %></span></div>
      <% } %>
    </div>
  </div>

  <div class="leaderboard">
    <div class="lb-header">
      <span class="lb-title">Bestenliste · Club-Mitglieder</span>
      <% if (challenge.segment_id) { %>
      <a href="https://www.strava.com/segments/<%= challenge.segment_id %>" target="_blank" class="lb-strava-link">Segment auf Strava →</a>
      <% } %>
    </div>
    <% if (!leaderboard || leaderboard.length === 0) { %>
    <div class="empty-lb">Noch keine Einträge – oder Strava-Segment-ID nicht konfiguriert.</div>
    <% } else { leaderboard.forEach(function(e, i) { %>
    <div class="lb-row <%= i===0?'top-1':i===1?'top-2':i===2?'top-3':'' %>">
      <div class="lb-rank"><% if(i===0){%><span class="trophy">🥇</span><%}else if(i===1){%><span class="trophy">🥈</span><%}else if(i===2){%><span class="trophy">🥉</span><%}else{%><%= i+1 %><%}%></div>
      <div>
        <div class="lb-name"><%= e.athlete_name || (e.athlete && (e.athlete.firstname+' '+e.athlete.lastname)) || 'Unbekannt' %></div>
        <% if (e.efforts_count) { %><div class="lb-sub"><%= e.efforts_count %> Versuch<%= e.efforts_count !== 1 ? 'e' : '' %></div><% } %>
      </div>
      <div class="lb-time">
        <%
          var s = e.elapsed_time || e.moving_time || 0;
          var mm = Math.floor(s/60);
          var ss = s%60;
          var timeStr = mm+':'+String(ss).padStart(2,'0');
        %>
        <%= timeStr %> min
      </div>
    </div>
    <% }); } %>
  </div>

  <div class="prize-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
    Der Gewinner wird bei der Weihnachtsfeier bekanntgegeben. Viel Erfolg!
  </div>

  <% } %>
</div>
</body>
</html>
