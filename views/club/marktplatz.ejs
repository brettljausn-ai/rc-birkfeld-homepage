<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Marktplatz – RC Birkfeld Club</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;overflow-x:auto;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;white-space:nowrap;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  .ch-profile-link{display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
  /* marktplatz */
  .wrap{max-width:720px;margin:0 auto;padding:24px 16px;}
  .page-title{font-family:'Big Shoulders Display',sans-serif;font-size:1.8rem;font-weight:900;margin-bottom:4px;}
  .page-sub{font-size:0.82rem;color:#555;margin-bottom:24px;font-family:'IBM Plex Mono',monospace;}
  .add-form{background:#141414;border:1px solid #1e1e1e;border-radius:12px;padding:20px;margin-bottom:28px;}
  .add-form h3{font-size:0.95rem;font-weight:700;margin-bottom:14px;color:#aaa;}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
  .form-group{display:flex;flex-direction:column;gap:4px;}
  label{font-size:0.75rem;color:#555;font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.05em;}
  input[type=text],input[type=number],input[type=url],textarea{background:#0d0d0d;border:1px solid #2a2a2a;color:#E8E8E8;border-radius:6px;padding:8px 10px;font-size:0.88rem;font-family:inherit;outline:none;width:100%;}
  input:focus,textarea:focus{border-color:#4CAF50;}
  textarea{resize:vertical;min-height:72px;}
  .btn-add{background:#1F7A34;color:#fff;border:none;padding:9px 22px;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer;font-family:inherit;margin-top:8px;}
  .btn-add:hover{background:#145C27;}
  .drop-zone{border:2px dashed #2a2a2a;border-radius:8px;padding:14px;text-align:center;color:#444;font-size:0.8rem;cursor:pointer;transition:border-color .15s,color .15s;}
  .drop-zone.over{border-color:#4CAF50;color:#4CAF50;}
  .drop-zone input[type=file]{display:none;}
  .drop-preview{display:none;margin-top:8px;position:relative;}
  .drop-preview img{width:100%;max-height:160px;object-fit:cover;border-radius:6px;display:block;}
  .drop-remove{position:absolute;top:4px;right:4px;background:rgba(0,0,0,.7);border:none;color:#fff;border-radius:50%;width:22px;height:22px;cursor:pointer;font-size:0.85rem;line-height:22px;text-align:center;padding:0;}
  .upload-st{font-size:0.72rem;color:#555;font-family:'IBM Plex Mono',monospace;margin-top:4px;}
  .listing-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:520px){.listing-grid{grid-template-columns:1fr;}}
  .listing{background:#141414;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;position:relative;}
  .listing.sold{opacity:.55;}
  .sold-badge{position:absolute;top:10px;right:10px;background:#c62828;color:#fff;font-size:0.68rem;font-weight:700;font-family:'IBM Plex Mono',monospace;padding:3px 9px;border-radius:10px;text-transform:uppercase;letter-spacing:.06em;z-index:2;}
  .listing-img{width:100%;height:160px;object-fit:cover;display:block;background:#1a1a1a;}
  .listing-img-placeholder{width:100%;height:120px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;color:#2a2a2a;}
  .listing-body{padding:14px 16px;}
  .listing-price{font-family:'Big Shoulders Display',sans-serif;font-size:1.4rem;font-weight:900;color:#4CAF50;margin-bottom:4px;}
  .listing-vb{font-size:0.75rem;color:#555;}
  .listing-title{font-size:0.92rem;font-weight:700;margin-bottom:4px;}
  .listing-desc{font-size:0.82rem;color:#888;line-height:1.5;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;}
  .listing-meta{font-size:0.72rem;color:#444;font-family:'IBM Plex Mono',monospace;margin-bottom:10px;}
  .listing-contact{display:flex;align-items:center;gap:6px;font-size:0.8rem;color:#4CAF50;font-weight:600;margin-bottom:10px;}
  .listing-actions{display:flex;gap:6px;flex-wrap:wrap;}
  .btn-sold{background:#1F7A34;color:#fff;border:none;padding:5px 12px;border-radius:6px;font-size:0.75rem;font-weight:700;cursor:pointer;font-family:inherit;}
  .btn-del{background:none;border:1px solid #2a2a2a;color:#555;padding:5px 10px;border-radius:6px;font-size:0.75rem;cursor:pointer;font-family:inherit;}
  .btn-del:hover{color:#e57373;border-color:#5c2020;}
  .empty{text-align:center;color:#333;padding:60px 0;font-size:0.9rem;}
  @media(max-width:520px){.form-row{grid-template-columns:1fr;}}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="wrap">
  <h1 class="page-title">Marktplatz</h1>
  <p class="page-sub">Gebrauchte Räder, Teile und Ausrüstung von Vereinsmitgliedern.</p>

  <div class="add-form">
    <h3>Inserat aufgeben</h3>
    <form method="POST" action="/club/marktplatz" id="mkForm">
      <div class="form-row">
        <div class="form-group" style="grid-column:1/-1;">
          <label>Titel</label>
          <input type="text" name="title" placeholder="z.B. Trek Domane SL5 2022 – Gr. 56" required maxlength="200">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Preis (€) – leer lassen für VHB</label>
          <input type="number" name="price" placeholder="450" min="0" step="0.01">
        </div>
        <div class="form-group">
          <label>Kontakt (Name / WhatsApp)</label>
          <input type="text" name="contact" placeholder="z.B. Klaus · 0664 123 456" maxlength="200">
        </div>
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label>Beschreibung</label>
        <textarea name="description" placeholder="Zustand, Baujahr, Besonderheiten…" maxlength="1000"></textarea>
      </div>
      <div class="form-group" style="margin-bottom:12px;">
        <label>Foto (optional)</label>
        <div class="drop-zone" id="mkDrop">
          <input type="file" id="mkFile" accept="image/*">
          ↑ Bild ablegen oder klicken
          <div class="drop-preview" id="mkPreview">
            <img id="mkPreviewImg" src="" alt="">
            <button type="button" class="drop-remove" id="mkRemove">×</button>
          </div>
          <div class="upload-st" id="mkStatus"></div>
        </div>
        <input type="hidden" name="image_url" id="mkImageUrl">
      </div>
      <button type="submit" class="btn-add">Inserat veröffentlichen</button>
    </form>
  </div>

  <% var active = inserate.filter(function(i){return !i.sold;}); %>
  <% var sold   = inserate.filter(function(i){return i.sold;}); %>

  <% if (!inserate.length) { %>
  <div class="empty">Noch keine Inserate. Sei der Erste!</div>
  <% } else { %>

  <% if (active.length) { %>
  <div style="font-family:'IBM Plex Mono',monospace;font-size:0.68rem;text-transform:uppercase;letter-spacing:.1em;color:#444;font-weight:700;margin-bottom:12px;"><%= active.length %> Aktive Inserate</div>
  <div class="listing-grid" style="margin-bottom:28px;">
    <% active.forEach(function(ins) { %>
    <div class="listing">
      <% if (ins.image_url) { %>
        <img class="listing-img" src="<%= ins.image_url %>" alt="<%= ins.title %>" loading="lazy" onerror="this.style.display='none'">
      <% } else { %>
        <div class="listing-img-placeholder"><svg width="32" height="32" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <% } %>
      <div class="listing-body">
        <% if (ins.price) { %>
          <div class="listing-price">€ <%= parseFloat(ins.price).toLocaleString('de-AT',{minimumFractionDigits:0}) %></div>
        <% } else { %>
          <div class="listing-price" style="font-size:1rem;color:#888;">Preis VHB</div>
        <% } %>
        <div class="listing-title"><%= ins.title %></div>
        <% if (ins.description) { %><div class="listing-desc"><%= ins.description %></div><% } %>
        <div class="listing-meta">von <%= ins.author %> · <%= new Date(ins.created_at).toLocaleDateString('de-AT',{day:'2-digit',month:'short',year:'numeric'}) %></div>
        <% if (ins.contact) { %>
          <div class="listing-contact">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <%= ins.contact %>
          </div>
        <% } %>
        <% if (ins.author === memberName) { %>
        <div class="listing-actions">
          <form method="POST" action="/club/marktplatz/<%= ins.id %>/sold" style="display:inline;">
            <button class="btn-sold" type="submit">Als verkauft markieren</button>
          </form>
          <form method="POST" action="/club/marktplatz/<%= ins.id %>/delete" onsubmit="return confirm('Inserat löschen?')" style="display:inline;">
            <button class="btn-del" type="submit">Löschen</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>

  <% if (sold.length) { %>
  <div style="font-family:'IBM Plex Mono',monospace;font-size:0.68rem;text-transform:uppercase;letter-spacing:.1em;color:#333;font-weight:700;margin-bottom:12px;">Verkauft</div>
  <div class="listing-grid">
    <% sold.forEach(function(ins) { %>
    <div class="listing sold">
      <span class="sold-badge">Verkauft</span>
      <% if (ins.image_url) { %><img class="listing-img" src="<%= ins.image_url %>" alt="" loading="lazy" onerror="this.style.display='none'"><% } %>
      <div class="listing-body">
        <div class="listing-title"><%= ins.title %></div>
        <div class="listing-meta">von <%= ins.author %></div>
        <% if (ins.author === memberName) { %>
        <form method="POST" action="/club/marktplatz/<%= ins.id %>/delete" onsubmit="return confirm('Inserat löschen?')" style="margin-top:8px;">
          <button class="btn-del" type="submit">Löschen</button>
        </form>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
  <% } %>
  <% } %>
</div>
<script>
var drop=document.getElementById('mkDrop'),file=document.getElementById('mkFile'),prev=document.getElementById('mkPreview'),prevImg=document.getElementById('mkPreviewImg'),rem=document.getElementById('mkRemove'),hidden=document.getElementById('mkImageUrl'),st=document.getElementById('mkStatus');
drop.addEventListener('click',function(e){if(e.target!==rem)file.click();});
drop.addEventListener('dragover',function(e){e.preventDefault();drop.classList.add('over');});
drop.addEventListener('dragleave',function(){drop.classList.remove('over');});
drop.addEventListener('drop',function(e){e.preventDefault();drop.classList.remove('over');if(e.dataTransfer.files[0])upload(e.dataTransfer.files[0]);});
file.addEventListener('change',function(){if(file.files[0])upload(file.files[0]);});
rem.addEventListener('click',function(e){e.stopPropagation();hidden.value='';prevImg.src='';prev.style.display='none';file.value='';st.textContent='';});
function upload(f){if(!f.type.match(/^image\//)){st.textContent='Nur Bilder erlaubt.';return;}prevImg.src=URL.createObjectURL(f);prev.style.display='block';st.textContent='Wird hochgeladen…';var fd=new FormData();fd.append('image',f);fetch('/club/upload-image',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(d){if(d.url){hidden.value=d.url;st.textContent='Bild bereit.';}else{st.textContent='Fehler.';prev.style.display='none';}}).catch(function(){st.textContent='Fehler.';});}
</script>
</body>
</html>
