<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Feed – RC Birkfeld Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
  /* feed */
  .feed-wrap{max-width:600px;margin:0 auto;padding:24px 16px;}
  .avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.82rem;font-weight:700;color:#fff;flex-shrink:0;}
  .compose{background:#141414;border:1px solid #1e1e1e;border-radius:12px;padding:16px;margin-bottom:24px;}
  .compose-top{display:flex;gap:12px;align-items:flex-start;margin-bottom:12px;}
  .compose textarea{flex:1;background:transparent;border:none;color:#E8E8E8;font-family:inherit;font-size:0.95rem;resize:none;outline:none;min-height:72px;line-height:1.5;}
  .compose textarea::placeholder{color:#444;}
  .compose-bottom{display:flex;align-items:center;gap:10px;border-top:1px solid #1e1e1e;padding-top:12px;}
  .btn-post{background:#1F7A34;color:#fff;border:none;padding:8px 20px;border-radius:20px;font-size:0.85rem;font-weight:700;cursor:pointer;font-family:inherit;}
  .btn-post:hover{background:#145C27;}
  @keyframes skel-shine{to{background-position:-200% center;}}
  .drop-zone{border:2px dashed #2a2a2a;border-radius:8px;padding:18px;text-align:center;color:#444;font-size:0.8rem;cursor:pointer;transition:border-color .15s,color .15s;margin-top:0;}
  .drop-zone.over{border-color:#4CAF50;color:#4CAF50;}
  .drop-zone input[type=file]{display:none;}
  .drop-preview{position:relative;margin-top:10px;display:none;}
  .drop-preview img{width:100%;max-height:280px;object-fit:cover;border-radius:8px;display:block;}
  .drop-remove{position:absolute;top:6px;right:6px;background:rgba(0,0,0,.7);border:none;color:#fff;border-radius:50%;width:26px;height:26px;cursor:pointer;font-size:1rem;line-height:26px;text-align:center;padding:0;}
  .upload-status{font-size:0.75rem;color:#555;margin-top:6px;font-family:'IBM Plex Mono',monospace;}
  .post-card{background:#141414;border:1px solid #1e1e1e;border-radius:12px;overflow:hidden;margin-bottom:16px;}
  .post-header{display:flex;align-items:center;gap:10px;padding:14px 16px 10px;}
  .post-author{font-weight:700;font-size:0.9rem;}
  .post-time{font-size:0.75rem;color:#555;font-family:'IBM Plex Mono',monospace;margin-top:1px;}
  .post-body{padding:0 16px 14px;font-size:0.93rem;line-height:1.65;color:#D8D8D8;white-space:pre-wrap;word-break:break-word;}
  .post-img{width:100%;max-height:480px;object-fit:cover;display:block;border-top:1px solid #1e1e1e;}
  .post-footer{padding:8px 16px;display:flex;justify-content:flex-end;}
  .btn-del{background:none;border:none;color:#333;font-size:0.75rem;cursor:pointer;font-family:inherit;padding:4px 8px;border-radius:4px;}
  .btn-del:hover{color:#e57373;background:#1e1010;}
  .empty{text-align:center;color:#333;padding:60px 0;font-size:0.9rem;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="feed-wrap">

  <form id="composeForm" class="compose">
    <div class="compose-top">
      <div class="avatar" style="background:<%= avatarColor(memberName) %>;"><%= initials(memberName) %></div>
      <textarea name="content" placeholder="Was gibt's Neues?" required></textarea>
    </div>
    <div class="drop-zone" id="dropZone">
      <input type="file" id="fileInput" accept="image/*">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="vertical-align:middle;margin-right:6px;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><polyline points="17 8 12 3 7 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="3" x2="12" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Bild hier ablegen oder klicken zum Auswählen
      <div class="drop-preview" id="dropPreview">
        <img id="previewImg" src="" alt="">
        <button class="drop-remove" id="removeImg" type="button">×</button>
      </div>
      <div class="upload-status" id="uploadStatus"></div>
    </div>
    <input type="hidden" name="image_url" id="imageUrlField">
    <div class="compose-bottom">
      <button class="btn-post" type="submit" id="postBtn">Posten</button>
    </div>
  </form>

  <div id="feedPosts">
    <% for (var _si=0;_si<3;_si++) { %>
    <div class="post-card">
      <div class="post-header">
        <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(90deg,#1e1e1e 25%,#2a2a2a 50%,#1e1e1e 75%);background-size:200% auto;animation:skel-shine 1.5s linear infinite;flex-shrink:0;"></div>
        <div style="flex:1;margin-left:10px;display:flex;flex-direction:column;gap:6px;">
          <span style="height:14px;width:40%;background:linear-gradient(90deg,#1e1e1e 25%,#2a2a2a 50%,#1e1e1e 75%);background-size:200% auto;animation:skel-shine 1.5s linear infinite;border-radius:4px;display:block;"></span>
          <span style="height:11px;width:25%;background:linear-gradient(90deg,#1e1e1e 25%,#2a2a2a 50%,#1e1e1e 75%);background-size:200% auto;animation:skel-shine 1.5s linear infinite;border-radius:4px;display:block;"></span>
        </div>
      </div>
      <div class="post-body" style="display:flex;flex-direction:column;gap:6px;">
        <span style="height:14px;width:90%;background:linear-gradient(90deg,#1e1e1e 25%,#2a2a2a 50%,#1e1e1e 75%);background-size:200% auto;animation:skel-shine 1.5s linear infinite;border-radius:4px;display:block;"></span>
        <span style="height:14px;width:75%;background:linear-gradient(90deg,#1e1e1e 25%,#2a2a2a 50%,#1e1e1e 75%);background-size:200% auto;animation:skel-shine 1.5s linear infinite;border-radius:4px;display:block;"></span>
      </div>
    </div>
    <% } %>
  </div>
</div>
<script>
var MEMBER = '<%= memberName.replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';
var COLORS = ['#1F7A34','#1565C0','#7B1FA2','#E65100','#00838F','#C62828'];
function aColor(n){var h=0;for(var i=0;i<n.length;i++)h=(h*31+n.charCodeAt(i))&0xFFFF;return COLORS[h%COLORS.length];}
function aInit(n){return n.split(' ').map(function(w){return w[0]||'';}).join('').toUpperCase().slice(0,2);}
function escH(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

function loadFeed() {
  fetch('/club/api/feed').then(function(r){return r.json();}).then(function(posts){
    var el = document.getElementById('feedPosts');
    if(!posts.length){el.innerHTML='<div class="empty">Noch keine Beiträge. Sei der Erste!</div>';return;}
    el.innerHTML = posts.map(function(p){
      var ts = new Date(p.created_at);
      var diff = Math.floor((Date.now()-ts)/60000);
      var rel = diff<1?'Gerade eben':diff<60?('vor '+diff+' Min'):diff<1440?('vor '+Math.floor(diff/60)+' Std'):ts.toLocaleDateString('de-AT',{day:'2-digit',month:'2-digit',year:'numeric'});
      var del = p.author===MEMBER ? '<div class="post-footer"><form method="POST" action="/club/post/'+p.id+'/delete" onsubmit="return confirm(\'Beitrag löschen?\')"><button class="btn-del" type="submit">Löschen</button></form></div>' : '';
      var img = p.image_url ? '<img class="post-img" src="'+escH(p.image_url)+'" alt="" loading="lazy" onerror="this.style.display=\'none\'">' : '';
      return '<div class="post-card"><div class="post-header"><div class="avatar" style="background:'+aColor(p.author)+';">'+aInit(p.author)+'</div><div><div class="post-author">'+escH(p.author)+'</div><div class="post-time">'+rel+'</div></div></div>'+(p.content?'<div class="post-body">'+escH(p.content)+'</div>':'')+img+del+'</div>';
    }).join('');
  }).catch(function(){});
}
loadFeed();

var dropZone = document.getElementById('dropZone');
var fileInput = document.getElementById('fileInput');
var previewImg = document.getElementById('previewImg');
var dropPreview = document.getElementById('dropPreview');
var removeImg = document.getElementById('removeImg');
var imageUrlField = document.getElementById('imageUrlField');
var uploadStatus = document.getElementById('uploadStatus');
var postBtn = document.getElementById('postBtn');

dropZone.addEventListener('click', function(e) {
  if (e.target === removeImg) return;
  fileInput.click();
});
dropZone.addEventListener('dragover', function(e) { e.preventDefault(); dropZone.classList.add('over'); });
dropZone.addEventListener('dragleave', function() { dropZone.classList.remove('over'); });
dropZone.addEventListener('drop', function(e) {
  e.preventDefault();
  dropZone.classList.remove('over');
  var file = e.dataTransfer.files[0];
  if (file) handleFile(file);
});
fileInput.addEventListener('change', function() {
  if (fileInput.files[0]) handleFile(fileInput.files[0]);
});
removeImg.addEventListener('click', function(e) {
  e.stopPropagation();
  imageUrlField.value = '';
  previewImg.src = '';
  dropPreview.style.display = 'none';
  uploadStatus.textContent = '';
  fileInput.value = '';
});

function handleFile(file) {
  if (!file.type.match(/^image\//)) { uploadStatus.textContent = 'Nur Bilder erlaubt.'; return; }
  previewImg.src = URL.createObjectURL(file);
  dropPreview.style.display = 'block';
  uploadStatus.textContent = 'Wird hochgeladen…';
  postBtn.disabled = true;
  var fd = new FormData();
  fd.append('image', file);
  fetch('/club/upload-image', { method: 'POST', body: fd })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.url) {
        imageUrlField.value = data.url;
        uploadStatus.textContent = 'Bild bereit.';
      } else {
        uploadStatus.textContent = 'Fehler beim Hochladen.';
        dropPreview.style.display = 'none';
      }
      postBtn.disabled = false;
    })
    .catch(function() {
      uploadStatus.textContent = 'Fehler beim Hochladen.';
      postBtn.disabled = false;
    });
}

document.getElementById('composeForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var content = this.querySelector('textarea[name=content]').value.trim();
  if (!content) return;
  var imageUrl = imageUrlField.value;
  postBtn.disabled = true;
  fetch('/club/post', {method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'content='+encodeURIComponent(content)+'&image_url='+encodeURIComponent(imageUrl)})
    .then(function() {
      document.querySelector('textarea[name=content]').value = '';
      imageUrlField.value = '';
      dropPreview.style.display = 'none';
      uploadStatus.textContent = '';
      fileInput.value = '';
      postBtn.disabled = false;
      loadFeed();
    }).catch(function() { postBtn.disabled = false; });
});
</script>
</body>
</html>
