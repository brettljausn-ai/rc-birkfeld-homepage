<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<link rel="icon" type="image/png" href="/images/rcbirkfeld-logo.png">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Abstimmungen – RC Birkfeld Club</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;min-height:100vh;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;overflow-x:auto;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;white-space:nowrap;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  .ch-profile-link{display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
  /* polls */
  .wrap{max-width:640px;margin:0 auto;padding:24px 16px;}
  .page-title{font-family:'Big Shoulders Display',sans-serif;font-size:1.8rem;font-weight:900;margin-bottom:4px;}
  .page-sub{font-size:0.82rem;color:#555;margin-bottom:28px;font-family:'IBM Plex Mono',monospace;}
  .poll-card{background:#141414;border:1px solid #1e1e1e;border-radius:12px;padding:22px;margin-bottom:18px;}
  .poll-question{font-size:1.05rem;font-weight:700;margin-bottom:16px;line-height:1.4;}
  .poll-option{display:flex;align-items:center;gap:0;margin-bottom:10px;cursor:pointer;}
  .poll-option input[type=radio]{display:none;}
  .poll-option-label{flex:1;position:relative;background:#1a1a1a;border:2px solid #2a2a2a;border-radius:8px;padding:10px 14px;cursor:pointer;transition:border-color .15s;overflow:hidden;display:block;}
  .poll-option input:checked + .poll-option-label{border-color:#4CAF50;}
  .poll-option-label:hover{border-color:#3a3a3a;}
  .poll-option-text{position:relative;z-index:1;font-size:0.9rem;font-weight:600;}
  .poll-option-pct{position:relative;z-index:1;font-size:0.75rem;color:#666;font-family:'IBM Plex Mono',monospace;margin-top:2px;}
  .poll-bar{position:absolute;inset:0;background:#1F7A34;opacity:0.18;border-radius:6px;transition:width .5s ease;height:100%;top:0;left:0;}
  .poll-bar.winner{opacity:0.28;}
  .poll-submit{margin-top:14px;}
  .btn-vote{background:#1F7A34;color:#fff;border:none;padding:9px 22px;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer;font-family:inherit;}
  .btn-vote:hover{background:#145C27;}
  .poll-meta{font-size:0.72rem;color:#444;font-family:'IBM Plex Mono',monospace;margin-top:12px;}
  .voted-tag{display:inline-block;font-size:0.68rem;font-family:'IBM Plex Mono',monospace;text-transform:uppercase;letter-spacing:.07em;color:#4CAF50;background:#0d2a10;padding:2px 8px;border-radius:10px;margin-left:8px;}
  .total-votes{font-size:0.72rem;color:#444;font-family:'IBM Plex Mono',monospace;margin-top:8px;}
  .expires{font-size:0.72rem;color:#555;font-family:'IBM Plex Mono',monospace;margin-top:4px;}
  .empty{text-align:center;color:#333;padding:60px 0;font-size:0.9rem;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="wrap">
  <h1 class="page-title">Abstimmungen</h1>
  <p class="page-sub">Vereinsinterne Polls – deine Stimme zählt.</p>

  <% if (!polls || polls.length === 0) { %>
  <div class="empty">Keine offenen Abstimmungen.<br>Der Admin startet die nächste.</div>
  <% } else { polls.forEach(function(poll) {
    var options = poll.options;
    var myVote = myVotes[poll.id];
    var hasVoted = myVote !== undefined && myVote !== null;
    var counts = voteCounts[poll.id] || {};
    var totalVotes = options.reduce(function(sum, _, i){ return sum + (counts[i] || 0); }, 0);
    var maxVotes = Math.max.apply(null, options.map(function(_, i){ return counts[i] || 0; }));
  %>
  <div class="poll-card">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:14px;">
      <div class="poll-question"><%= poll.question %></div>
      <% if (hasVoted) { %><span class="voted-tag">Abgestimmt</span><% } %>
    </div>

    <form method="POST" action="/club/polls/<%= poll.id %>/vote">
      <% options.forEach(function(opt, i) {
        var cnt = counts[i] || 0;
        var pct = totalVotes > 0 ? Math.round((cnt / totalVotes) * 100) : 0;
        var isWinner = cnt === maxVotes && cnt > 0;
        var isMyVote = hasVoted && myVote === i;
      %>
      <label class="poll-option">
        <input type="radio" name="option_idx" value="<%= i %>" <%= isMyVote?'checked':'' %> <%= hasVoted?'disabled':'' %>>
        <span class="poll-option-label">
          <% if (hasVoted) { %><span class="poll-bar <%= isWinner?'winner':'' %>" style="width:<%= pct %>%;"></span><% } %>
          <span class="poll-option-text"><%= opt %><% if(isMyVote){ %> ✓<% } %></span>
          <% if (hasVoted) { %><span class="poll-option-pct"><%= pct %>% · <%= cnt %> Stimme<%= cnt !== 1?'n':'' %></span><% } %>
        </span>
      </label>
      <% }); %>

      <% if (!hasVoted) { %>
      <div class="poll-submit">
        <button type="submit" class="btn-vote">Abstimmen</button>
      </div>
      <% } %>
    </form>

    <div class="total-votes"><%= totalVotes %> Stimme<%= totalVotes !== 1 ? 'n' : '' %> gesamt</div>
    <% if (poll.expires_at) { %><div class="expires">Läuft ab: <%= new Date(poll.expires_at).toLocaleDateString('de-AT',{day:'2-digit',month:'long',year:'numeric'}) %></div><% } %>
  </div>
  <% }); } %>
</div>
</body>
</html>
