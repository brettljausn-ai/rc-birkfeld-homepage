<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chat – RC Birkfeld Club</title>
<%- include('_nav') %>
<style>
  html,body{height:100%;}
  body{display:flex;flex-direction:column;}
  .chat-page{flex:1;display:flex;flex-direction:column;height:calc(100vh - 54px);}
  .chat-messages{flex:1;overflow-y:auto;padding:16px 12px;display:flex;flex-direction:column;gap:14px;max-width:800px;width:100%;margin:0 auto;align-self:stretch;}
  /* day divider */
  .day-divider{text-align:center;font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:#333;position:relative;margin:8px 0;}
  .day-divider::before{content:'';position:absolute;left:0;right:0;top:50%;height:1px;background:#1e1e1e;z-index:0;}
  .day-divider span{background:#0D0D0D;padding:0 12px;position:relative;z-index:1;}
  /* message row */
  .msg-row{display:flex;gap:9px;align-items:flex-end;max-width:75%;}
  .msg-row.mine{align-self:flex-end;flex-direction:row-reverse;}
  .msg-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.68rem;font-weight:700;color:#fff;flex-shrink:0;}
  .msg-content{display:flex;flex-direction:column;gap:2px;}
  .msg-row.mine .msg-content{align-items:flex-end;}
  .msg-name{font-size:0.7rem;color:#555;padding:0 4px;font-weight:600;}
  .msg-row.mine .msg-name{display:none;}
  .bubble{background:#1e1e1e;border-radius:16px;border-bottom-left-radius:4px;padding:9px 14px;font-size:0.9rem;line-height:1.5;color:#E8E8E8;word-break:break-word;max-width:100%;}
  .msg-row.mine .bubble{background:#1a3a22;border-bottom-left-radius:16px;border-bottom-right-radius:4px;color:#E8E8E8;}
  .msg-time{font-family:'IBM Plex Mono',monospace;font-size:0.65rem;color:#333;padding:0 4px;}
  /* input bar */
  .chat-input-bar{border-top:1px solid #1e1e1e;padding:12px 16px;background:#111;}
  .chat-input-inner{display:flex;gap:10px;max-width:800px;margin:0 auto;align-items:center;}
  .chat-input-inner input{flex:1;background:#1a1a1a;border:1px solid #2a2a2a;color:#E8E8E8;padding:10px 16px;border-radius:24px;font-family:inherit;font-size:0.92rem;outline:none;}
  .chat-input-inner input:focus{border-color:#4CAF50;}
  .btn-send{width:40px;height:40px;border-radius:50%;background:#1F7A34;border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .15s;}
  .btn-send:hover{background:#145C27;}
  .typing{font-family:'IBM Plex Mono',monospace;font-size:0.68rem;color:#333;height:14px;text-align:center;padding:2px 0;}
</style>
</head>
<body>
<div class="chat-page">
  <div class="chat-messages" id="chatMessages">
    <% let lastDate = '';
    chat.forEach(m => {
      const d = new Date(m.created_at);
      const dateStr = d.toLocaleDateString('de-AT',{weekday:'long',day:'2-digit',month:'long'});
      if (dateStr !== lastDate) { lastDate = dateStr; %>
      <div class="day-divider"><span><%= dateStr %></span></div>
      <% } %>
    <div class="msg-row <%= m.author === memberName ? 'mine' : '' %>" data-id="<%= m.id %>">
      <% if (m.author !== memberName) { %>
      <div class="msg-avatar" style="background:<%= avatarColor(m.author) %>;"><%= initials(m.author) %></div>
      <% } %>
      <div class="msg-content">
        <% if (m.author !== memberName) { %><div class="msg-name"><%= m.author %></div><% } %>
        <div class="bubble"><%= m.content %></div>
        <div class="msg-time"><%= d.toLocaleTimeString('de-AT',{hour:'2-digit',minute:'2-digit'}) %></div>
      </div>
    </div>
    <% }); %>
  </div>
  <div class="typing" id="typingIndicator"></div>
  <div class="chat-input-bar">
    <div class="chat-input-inner">
      <input type="text" id="chatInput" placeholder="Nachricht an RC Birkfeld…" autocomplete="off">
      <button class="btn-send" id="sendBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13" stroke="white" stroke-width="2" stroke-linecap="round"/><path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="white" stroke-width="2" stroke-linejoin="round" fill="none"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
const memberName = '<%= memberName.replace(/\\/g,'\\\\').replace(/'/g,"\\'") %>';
const msgs = document.getElementById('chatMessages');
const input = document.getElementById('chatInput');
const avatarColors = ['#1F7A34','#1565C0','#7B1FA2','#E65100','#00838F','#C62828'];

function avatarColor(name) {
  let h = 0; for (const c of name) h = (h*31+c.charCodeAt(0))&0xFFFF;
  return avatarColors[h % avatarColors.length];
}
function initials(name) {
  return name.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);
}

// scroll to bottom
msgs.scrollTop = msgs.scrollHeight;

let lastId = 0;
const allMsgs = msgs.querySelectorAll('.msg-row[data-id]');
if (allMsgs.length) lastId = parseInt(allMsgs[allMsgs.length-1].dataset.id) || 0;

function renderMsg(m) {
  const mine = m.author === memberName;
  const d = new Date(m.created_at);
  const time = d.toLocaleTimeString('de-AT',{hour:'2-digit',minute:'2-digit'});
  const row = document.createElement('div');
  row.className = 'msg-row' + (mine ? ' mine' : '');
  row.dataset.id = m.id;
  const content = m.content.replace(/</g,'&lt;').replace(/>/g,'&gt;');
  row.innerHTML = (mine ? '' : `<div class="msg-avatar" style="background:${avatarColor(m.author)};">${initials(m.author)}</div>`) +
    `<div class="msg-content">${mine?'':'<div class="msg-name">'+m.author+'</div>'}<div class="bubble">${content}</div><div class="msg-time">${time}</div></div>`;
  return row;
}

async function poll() {
  try {
    const res = await fetch('/club/chat/poll?after=' + lastId);
    const data = await res.json();
    if (data.length) {
      const atBottom = msgs.scrollHeight - msgs.scrollTop - msgs.clientHeight < 60;
      data.forEach(m => {
        msgs.appendChild(renderMsg(m));
        lastId = Math.max(lastId, m.id);
      });
      if (atBottom) msgs.scrollTop = msgs.scrollHeight;
    }
  } catch(e) {}
}

async function sendMessage() {
  const content = input.value.trim();
  if (!content) return;
  input.value = '';
  input.focus();
  try {
    await fetch('/club/chat', {
      method: 'POST',
      headers: {'Content-Type':'application/x-www-form-urlencoded'},
      body: 'content=' + encodeURIComponent(content)
    });
    await poll();
    msgs.scrollTop = msgs.scrollHeight;
  } catch(e) {}
}

document.getElementById('sendBtn').addEventListener('click', sendMessage);
input.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }});
setInterval(poll, 8000);
input.focus();
</script>
</body>
</html>
