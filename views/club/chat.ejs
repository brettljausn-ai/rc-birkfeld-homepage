<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chat – RC Birkfeld Club</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{background:#0D0D0D;color:#E8E8E8;font-family:'Public Sans',system-ui,sans-serif;display:flex;flex-direction:column;}
  a{color:inherit;text-decoration:none;}
  .ch{background:#111;border-bottom:1px solid #1e1e1e;padding:0 20px;display:flex;align-items:center;height:54px;position:sticky;top:0;z-index:200;flex-shrink:0;}
  .ch-brand{font-family:'Big Shoulders Display',sans-serif;font-weight:900;font-size:1rem;color:#4CAF50;letter-spacing:.06em;white-space:nowrap;margin-right:28px;}
  .ch-tabs{display:flex;height:100%;flex:1;}
  .ch-tab{display:flex;align-items:center;gap:7px;padding:0 16px;color:#666;font-size:0.85rem;font-weight:600;border-bottom:3px solid transparent;text-decoration:none;transition:color .15s;}
  .ch-tab:hover{color:#aaa;} .ch-tab.active{color:#fff;border-bottom-color:#4CAF50;}
  .ch-right{display:flex;align-items:center;gap:10px;margin-left:auto;}
  .ch-avatar{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:700;color:#fff;flex-shrink:0;}
  .ch-name{font-size:0.82rem;color:#888;white-space:nowrap;}
  .ch-logout{font-size:0.75rem;color:#555;border:1px solid #2a2a2a;padding:4px 10px;border-radius:4px;text-decoration:none;}
  .ch-logout:hover{color:#aaa;border-color:#444;}
  @media(max-width:600px){.ch-name{display:none;}.ch-brand{margin-right:12px;}.ch-tab{padding:0 10px;font-size:0.78rem;}}
  /* chat */
  .chat-page{flex:1;display:flex;flex-direction:column;overflow:hidden;}
  .chat-messages{flex:1;overflow-y:auto;padding:16px 12px;display:flex;flex-direction:column;gap:12px;max-width:800px;width:100%;margin:0 auto;align-self:stretch;}
  .day-div{text-align:center;font-family:'IBM Plex Mono',monospace;font-size:0.67rem;color:#333;position:relative;margin:6px 0;}
  .day-div::before{content:'';position:absolute;left:0;right:0;top:50%;height:1px;background:#1e1e1e;}
  .day-div span{background:#0D0D0D;padding:0 12px;position:relative;}
  .msg-row{display:flex;gap:8px;align-items:flex-end;max-width:72%;}
  .msg-row.mine{align-self:flex-end;flex-direction:row-reverse;}
  .msg-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;color:#fff;flex-shrink:0;}
  .msg-col{display:flex;flex-direction:column;gap:2px;}
  .msg-row.mine .msg-col{align-items:flex-end;}
  .msg-name{font-size:0.68rem;color:#555;padding:0 4px;font-weight:600;}
  .bubble{background:#1e1e1e;border-radius:16px;border-bottom-left-radius:4px;padding:8px 13px;font-size:0.9rem;line-height:1.5;color:#E8E8E8;word-break:break-word;}
  .msg-row.mine .bubble{background:#1a3a22;border-bottom-left-radius:16px;border-bottom-right-radius:4px;}
  .msg-time{font-family:'IBM Plex Mono',monospace;font-size:0.63rem;color:#333;padding:0 4px;}
  .chat-bar{border-top:1px solid #1e1e1e;padding:12px 16px;background:#111;flex-shrink:0;}
  .chat-bar-inner{display:flex;gap:10px;max-width:800px;margin:0 auto;align-items:center;}
  .chat-bar-inner input{flex:1;background:#1a1a1a;border:1px solid #2a2a2a;color:#E8E8E8;padding:10px 16px;border-radius:24px;font-family:inherit;font-size:0.92rem;outline:none;}
  .chat-bar-inner input:focus{border-color:#4CAF50;}
  .btn-send{width:40px;height:40px;border-radius:50%;background:#1F7A34;border:none;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .btn-send:hover{background:#145C27;}
</style>
</head>
<body>
<%- include('_nav') %>
<div class="chat-page">
  <div class="chat-messages" id="chatMessages">
    <% var lastDate = '';
    chat.forEach(function(m) {
      var d = new Date(m.created_at);
      var dateStr = d.toLocaleDateString('de-AT',{weekday:'long',day:'2-digit',month:'long'});
      if (dateStr !== lastDate) { lastDate = dateStr; %>
      <div class="day-div"><span><%= dateStr %></span></div>
    <% } %>
    <div class="msg-row <%= m.author === memberName ? 'mine' : '' %>" data-id="<%= m.id %>">
      <% if (m.author !== memberName) { %>
      <div class="msg-av" style="background:<%= avatarColor(m.author) %>;"><%= initials(m.author) %></div>
      <% } %>
      <div class="msg-col">
        <% if (m.author !== memberName) { %><div class="msg-name"><%= m.author %></div><% } %>
        <div class="bubble"><%= m.content %></div>
        <div class="msg-time"><%= d.toLocaleTimeString('de-AT',{hour:'2-digit',minute:'2-digit'}) %></div>
      </div>
    </div>
    <% }); %>
  </div>
  <div class="chat-bar">
    <div class="chat-bar-inner">
      <input type="text" id="chatInput" placeholder="Nachricht an RC Birkfeld…" autocomplete="off">
      <button class="btn-send" id="sendBtn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M22 2L11 13" stroke="white" stroke-width="2" stroke-linecap="round"/><path d="M22 2L15 22l-4-9-9-4 20-7z" stroke="white" stroke-width="2" stroke-linejoin="round" fill="none"/></svg>
      </button>
    </div>
  </div>
</div>
<script>
var memberName = '<%= memberName.replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';
var COLORS = ['#1F7A34','#1565C0','#7B1FA2','#E65100','#00838F','#C62828'];
function aColor(n){var h=0;for(var i=0;i<n.length;i++)h=(h*31+n.charCodeAt(i))&0xFFFF;return COLORS[h%COLORS.length];}
function aInit(n){return n.split(' ').map(function(w){return w[0]||'';}).join('').toUpperCase().slice(0,2);}
var msgs = document.getElementById('chatMessages');
var input = document.getElementById('chatInput');
msgs.scrollTop = msgs.scrollHeight;
var lastId = 0;
var all = msgs.querySelectorAll('.msg-row[data-id]');
if(all.length) lastId = parseInt(all[all.length-1].dataset.id)||0;
function renderMsg(m){
  var mine = m.author === memberName;
  var d = new Date(m.created_at);
  var time = d.toLocaleTimeString('de-AT',{hour:'2-digit',minute:'2-digit'});
  var row = document.createElement('div');
  row.className = 'msg-row'+(mine?' mine':'');
  row.dataset.id = m.id;
  var txt = m.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  row.innerHTML = (mine?'':'<div class="msg-av" style="background:'+aColor(m.author)+';">'+aInit(m.author)+'</div>')+
    '<div class="msg-col">'+(mine?'':'<div class="msg-name">'+m.author+'</div>')+
    '<div class="bubble">'+txt+'</div><div class="msg-time">'+time+'</div></div>';
  return row;
}
async function poll(){
  try{
    var res = await fetch('/club/chat/poll?after='+lastId);
    var data = await res.json();
    if(data.length){
      var atBot = msgs.scrollHeight-msgs.scrollTop-msgs.clientHeight<60;
      data.forEach(function(m){msgs.appendChild(renderMsg(m));lastId=Math.max(lastId,m.id);});
      if(atBot) msgs.scrollTop=msgs.scrollHeight;
    }
  }catch(e){}
}
async function send(){
  var content = input.value.trim();
  if(!content) return;
  input.value='';
  try{
    await fetch('/club/chat',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'content='+encodeURIComponent(content)});
    await poll();
    msgs.scrollTop=msgs.scrollHeight;
  }catch(e){}
}
document.getElementById('sendBtn').addEventListener('click',send);
input.addEventListener('keydown',function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send();}});
setInterval(poll,8000);
input.focus();
</script>
</body>
</html>
